(in-package :borrowglass)
(defstruct challenge key key-id rows salt digest floors tx clock tokens)
(defun initialize-challenge (entropy clock)
  (unless (>= (length entropy) 68) (error "initialization_entropy_size"))
  (let* ((now (funcall clock)) (key (subseq entropy 0 32)) (salt (subseq entropy 32 48))
         (c-row (list 3 (get-le entropy 48 4) (get-le entropy 52 4) (get-le entropy 56 4)))
         (kid (subseq entropy 60 68))
         (state (make-challenge :key key :key-id kid :salt salt :digest (target-digest salt c-row)
                  :rows (vector '(1 101 102 103) '(2 201 202 203) c-row)
                  :clock clock :tx (make-transaction)
                  :floors (make-pool :slots (list (make-floor-entry :relation 7 :occupied t))))))
    (setf (challenge-tokens state)
      (loop for tenant from 1 to 3 collect
        (result-value (authenticate-token key
          (make-capability :key-id kid :subject tenant :relation 7 :mask 15
            :privileges (if (= tenant 2) 1 15) :predicate (list :literal 0 :eq tenant)
            :not-before now :expiry (+ now 3600))))))
    state))
(defun ledger-program (row tok req)
  (let* ((writep (= (request-kind req) 3)) (kind (if writep :mut-borrow :borrow))
         (mode (if writep :unique :shared)) (slice-ty (list :words "row" mode 4))
         (tok-ty (list :token kind "row"))
         (slice (make-word-slice :region "row" :id 6 :mode mode :cap 4 :words (copy-list row)))
         (bw (make-row-token :id 6))
         (var (list :var "row-data" slice-ty)) (tv (list :var "permit" tok-ty))
         (err '(:error "error-code" ("permit")))
         (refuse (list :return :refuse (list tv) (list "permit")))
         (ret-types (if writep (list slice-ty tok-ty) (list :u32 tok-ty)))
         (sig (list :params (list (list "row-data" slice-ty) (list "permit" tok-ty))
                    :return (list :result ret-types nil 42501) :effects (if writep 1 0)))
         (body (if writep
             (list :slice-set "row-data" (scalar :u32 (request-column req)) (scalar :u32 (request-value req))
                   "permit" "next-permit" 22020
                   (list :return :ok (list var (list :var "next-permit" tok-ty)) (list "next-permit")) err refuse)
             (list :match (list :slice-ref var (scalar :u32 (request-column req)) "permit" 22020)
                   (list (list "projected" :u32))
                   (list :return :ok (list (list :var "projected" :u32) tv) (list "permit")) err refuse)))
         (mask (logior (ash 1 (request-column req))
                       (result-value (predicate-columns 4 (capability-predicate tok)))))
         (m (make-module :name "bg.primitive.memory" :columns 4 :mask mask :effective-mask mask
                :row-policy (capability-predicate tok)
                :regions (list (make-region :name "row" :id 6 :class :row :cap 1024))
                :signatures (list (cons "entry" sig)) :declarations (list (list "entry" sig body)))))
    (make-program :name "ledger-operation" :module m :entry "entry" :tuple (copy-list row)
                  :environment (list (cons "row-data" (list :words slice)) (cons "permit" (list :row-token bw))))))
(defun ledger-operation (state raw req)
  (block operation
    (labels ((refuse (&optional (code 42501) (phase 2))
               (return-from operation (list :refused phase code nil))))
      (unless (and (= (length raw) 384)
                   (equalp (subseq raw 4 12) (challenge-key-id state))
                   (tag-equal-p (subseq raw 352) (hmac-blake2s (challenge-key state) (subseq raw 0 352))))
        (refuse))
      (let ((decoded (open-token-bytes raw)))
        (unless (okp decoded) (refuse 42601 3))
        (let* ((tok (result-value decoded)) (now (funcall (challenge-clock state)))
               (col (request-column req)) (index (request-row req))
               (expiry (reduce #'min (capability-caveats tok) :key #'caveat-expiry
                                :initial-value (capability-expiry tok))))
          (unless (and (= (request-relation req) (capability-relation tok))
                       (member (request-kind req) '(2 3)) (< index (length (challenge-rows state)))
                       (< col 4) (logbitp (if (= (request-kind req) 2) 0 2) (capability-privileges tok))
                       (<= (capability-not-before tok) now) (< now expiry)
                       (logbitp col (effective-mask tok))
                       (or (/= (request-kind req) 3) (/= col 0))) (refuse))
          (unless (okp (relation-floor (challenge-floors state) (request-relation req) (capability-epoch tok))) (refuse))
          (unless (okp (revocation-gate (challenge-tx state) tok)) (refuse 53200))
          (let* ((before (copy-list (aref (challenge-rows state) index)))
                 (references (predicate-columns 4 (capability-predicate tok))))
            (unless (okp references) (refuse 42601 4))
            (let ((outcome (run-program (ledger-program before tok req) (list (challenge-tx state) tok))))
              (case (outcome-kind outcome)
                (:accepted
                 (if (= (request-kind req) 2)
                     (let ((v (first (outcome-values outcome))))
                       (unless (eq (car v) :u32) (refuse 42601 5))
                       (list :accepted 0 0 (second v)))
                     (let* ((v (first (outcome-values outcome)))
                            (slice (and (eq (car v) :words) (second v)))
                            (proposed (and slice (word-slice-words slice))))
                       (unless (and (= (length proposed) 4) (= (first proposed) (first before))
                                    (every (lambda (w) (<= 0 w #xffffffff)) proposed)) (refuse 42501 5))
                       (let ((gate (run-predicate proposed (capability-predicate tok) (make-scratch :cap 1024))))
                         (unless (and (okp gate) (first (result-value gate))) (refuse 42501 5)))
                       (setf (aref (challenge-rows state) index) (copy-list proposed))
                       (list :accepted 0 0 (nth col proposed)))))
                (:filtered (list :filtered 4 42501 nil))
                (otherwise (list :refused (if (eq (outcome-kind outcome) :static) 4 5)
                                 (outcome-code outcome) nil))))))))))

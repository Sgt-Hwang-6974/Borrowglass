(in-package :borrowglass)
(defparameter *allocation-classes* '(:static :pool :session :transaction :plan :row))
(defun aggregate-cap (class)
  (ecase class (:static 16777216) (:pool 33554432) (:session 67108864)
    (:transaction 512) (:plan 67108864) (:row 16777216)))
(defun nominal-cap (class) (if (eq class :transaction) 16777216 (aggregate-cap class)))
(defun instance-cap (class)
  (case class ((:session :plan) 4194304) (:transaction 32)
    (otherwise (aggregate-cap class))))
(defun reset-class-p (class) (member class '(:row :plan :session)))
(defstruct budget (bytes (make-list 6 :initial-element 0))
  (counts (make-list 6 :initial-element 0)) ids names)
(defconstant +active-arena-cap+ 201326592)
(defconstant +transaction-header-size+ 32)
(defconstant +wide-maximum+ 18446744073709551615)
(defun budget-total (b) (u64 (reduce #'+ (budget-bytes b))))
(defun admit-single-region (decl)
  (bind-good (budget (admit-region (make-budget) decl)) (declare (ignore budget)) (good decl)))
(defun admit-region (budget decl)
  (let* ((class (region-class decl)) (idx (position class *allocation-classes*))
         (cap (region-cap decl)) (bytes (budget-bytes budget))
         (next (u64 (+ cap (nth idx bytes))))
         (count (if (member class '(:session :transaction :plan))
                    (u32 (1+ (nth idx (budget-counts budget)))) (nth idx (budget-counts budget)))))
    (cond
      ((or (member (region-id decl) (budget-ids budget))
           (member (region-name decl) (budget-names budget) :test #'equal))
       (syntax-bad "duplicate_region_decl:~A" (region-name decl)))
      ((or (= cap 0) (> cap (instance-cap class)) (> cap (aggregate-cap class))
           (> (u64 (+ (budget-total budget) cap)) +active-arena-cap+)) (bad :arena-cap))
      ((and (eq class :session)
            (or (< cap 32) (> (u64 (+ next (nth 3 bytes))) 67108864))) (bad :arena-cap))
      ((and (eq class :session) (> count 16)) (bad :connections))
      ((and (eq class :transaction)
            (or (/= cap 32) (> count 16) (> (u64 (+ (nth 2 bytes) next)) 67108864)))
       (bad :arena-cap))
      ((and (eq class :plan) (> count 16)) (bad :arena-cap))
      ((> next (aggregate-cap class)) (bad :arena-cap))
      (t (let ((b (copy-budget budget)))
           (setf (budget-bytes b) (copy-list bytes)
                 (budget-counts b) (copy-list (budget-counts b)))
           (setf (nth idx (budget-bytes b)) next (nth idx (budget-counts b)) count
                 (budget-ids b) (cons (region-id decl) (budget-ids b))
                 (budget-names b) (cons (region-name decl) (budget-names b)))
           (good b))))))
(defun admit-regions (decls) (admit-regions-aux (make-budget) decls))
(defun increment-generation (n)
  (if (= n +wide-maximum+) (bad :generation) (good (1+ n))))
(defun bump-epoch (tx)
  (bind-good (n (increment-generation (transaction-pin tx)))
    (let ((next (copy-transaction tx))) (setf (transaction-pin next) n) (good next))))
(defun enter-region (decl &optional owned)
  (if (member (region-id decl) owned) (bad :stale)
      (bind-good (b (admit-regions (list decl)))
        (declare (ignore b))
        (good (make-arena-cap :id (region-id decl) :class (region-class decl)
                              :cap (region-cap decl))))))
(defun enter-row-initial (op decl &optional owned)
  (if (not (eq (region-class decl) :row)) (bad :stale)
      (bind-good (cap (enter-region decl owned))
        (good (list (make-scratch :op op :id (region-id decl) :cap (region-cap decl))
                    cap (make-row-token :op op :id (region-id decl)))))))
(defun reset-arena (cap id epoch)
  (if (or (not (reset-class-p (arena-cap-class cap)))
          (/= id (arena-cap-id cap)) (/= epoch (arena-cap-epoch cap)))
      (bad :stale)
      (bind-good (n (increment-generation epoch))
        (let ((next (copy-arena-cap cap)))
          (setf (arena-cap-epoch next) n (arena-cap-used next) 0) (good next)))))
(defun reenter-row (s cap tok)
  (if (or (not (eq (arena-cap-class cap) :row))
          (/= (scratch-cap s) (arena-cap-cap cap))
          (/= (scratch-op s) (row-token-op tok))
          (/= (scratch-id s) (row-token-id tok))
          (/= (scratch-id s) (arena-cap-id cap))
          (/= (scratch-epoch s) (row-token-epoch tok))
          (/= (scratch-epoch s) (arena-cap-epoch cap)))
      (bad :stale)
      (bind-good (next (reset-arena cap (row-token-id tok) (row-token-epoch tok)))
        (let ((ns (copy-scratch s)) (nt (copy-row-token tok)))
          (setf (scratch-used ns) 0 (scratch-epoch ns) (arena-cap-epoch next)
                (row-token-epoch nt) (arena-cap-epoch next))
          (good (list ns next nt))))))
(defun end-row (s cap tok)
  (bind-good (triple (reenter-row s cap tok)) (good (subseq triple 0 2))))
(defun relation-floor (p relation epoch)
  (let ((entry (find-if (lambda (e) (and (floor-entry-occupied e)
                                (= relation (floor-entry-relation e)))) (pool-slots p))))
    (if (and entry (>= epoch (floor-entry-minimum entry))) (good) (bad :privilege))))
(defun advance-floor (p relation)
  (let ((idx (position-if (lambda (e) (and (floor-entry-occupied e)
                            (= relation (floor-entry-relation e)))) (pool-slots p))))
    (if (null idx) (bad :privilege)
        (let ((entry (nth idx (pool-slots p))))
          (bind-good (next (increment-generation (floor-entry-minimum entry)))
            (let ((np (copy-pool p)) (ne (copy-floor-entry entry)))
              (setf (floor-entry-minimum ne) next
                    (pool-slots np) (copy-list (pool-slots p))
                    (nth idx (pool-slots np)) ne)
              (good (list np next))))))))


(defun admit-regions-aux (budget decls)
 (dolist (decl decls (good budget))
  (let ((r (admit-region budget decl)))
   (unless (okp r) (return-from admit-regions-aux r)) (setf budget (result-value r)))))
(defun next-generation (value) (increment-generation value))



(defun example-row-declaration () (make-region :name "rRow" :id 6 :class :row :cap 16777216))
(defun region-lifecycle-trace ()
 (bind-good (initial (enter-row-initial 1 (example-row-declaration)))
  (destructuring-bind (s c tok) initial
   (bind-good (next (reenter-row s c tok))
    (format nil "init_ep=~D | reenter_ep=~D | stale=~S | endScan=~S | maxGen=~S | txMetaBytes=~D"
     (row-token-epoch tok) (row-token-epoch (third next))
     (reenter-row (first next) (second next) tok) (end-row (first next) (second next) (third next))
     (increment-generation +wide-maximum+) +transaction-header-size+)))))

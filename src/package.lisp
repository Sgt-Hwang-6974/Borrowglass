(defpackage :borrowglass (:use :cl))
(in-package :borrowglass)
(defvar *root*)
(defvar *checks* 0)
(defun insist (test label)
  (incf *checks*)
  (unless test (error "check-failed: ~A" label))
  t)
(defun octets (n) (make-array n :element-type '(unsigned-byte 8) :initial-element 0))
(defun ascii (s) (map '(vector (unsigned-byte 8)) #'char-code s))
(defun cat-bytes (&rest buffers)
  (apply #'concatenate '(vector (unsigned-byte 8)) buffers))
(defun hex-bytes (bytes)
  (string-downcase (format nil "~{~2,'0X~}" (coerce bytes 'list))))
(defun unhex (s)
  (unless (evenp (length s)) (error "odd hex length"))
  (map '(vector (unsigned-byte 8))
       (lambda (i) (parse-integer s :start i :end (+ i 2) :radix 16))
       (loop for i below (length s) by 2 collect i)))
(defun u32 (n) (ldb (byte 32 0) n))
(defun u64 (n) (ldb (byte 64 0) n))
(defun i64 (n) (let ((w (u64 n))) (if (logbitp 63 w) (- w (ash 1 64)) w)))

(in-package :borrowglass)
(defconstant +predicate-depth-cap+ 16)
(defconstant +predicate-node-cap+ 16)
(defconstant +column-count-cap+ 64)
(defconstant +predicate-frame-bytes+ 16)
(defun predicate-depth (p)
  (case (car p) (:not (1+ (predicate-depth (second p))))
    ((:and :or) (1+ (max (predicate-depth (second p)) (predicate-depth (third p)))))
    (otherwise 1)))
(defun predicate-nodes (p)
  (case (car p) (:not (1+ (predicate-nodes (second p))))
    ((:and :or) (+ 1 (predicate-nodes (second p)) (predicate-nodes (third p))))
    (otherwise 1)))
(defun predicate-bounds-with-caps (p depth nodes)
  (cond ((> (predicate-depth p) depth)
         (syntax-bad "rowPred_depth_exceeded:~D" (predicate-depth p)))
        ((> (predicate-nodes p) nodes)
         (syntax-bad "rowPred_nodes_exceeded:~D" (predicate-nodes p)))
        (t (good))))
(defun column-bit (columns index)
  (cond ((> columns 64) (syntax-bad "table_col_count_exceeds_m0_64_ceiling:~D" columns))
        ((or (>= index columns) (>= index 64))
         (syntax-bad "rowPred_col_idx_out_of_range:~D:max=~D" index columns))
        (t (good (ash 1 index)))))
(defun predicate-columns (columns p)
  (case (car p)
    ((:true :false) (if (> columns 64)
                       (syntax-bad "table_col_count_exceeds_m0_64_ceiling:~D" columns)
                       (good 0)))
    (:literal (column-bit columns (second p)))
    (:columns (bind-good (a (column-bit columns (second p)))
                (bind-good (b (column-bit columns (fourth p))) (good (logior a b)))))
    (:not (predicate-columns columns (second p)))
    ((:and :or) (bind-good (a (predicate-columns columns (second p)))
                 (bind-good (b (predicate-columns columns (third p))) (good (logior a b)))))
    (otherwise (syntax-bad "predicate_constructor"))))
(defun effective-mask (tok)
  (reduce #'logand (capability-caveats tok) :key #'caveat-mask
          :initial-value (capability-mask tok)))
(defun predicate-narrows-p (m tok)
  (cond ((eq (car m) :false) t) ((eq (car tok) :true) t)
        ((eq (car tok) :and) (and (predicate-narrows-p m (second tok))
                                  (predicate-narrows-p m (third tok))))
        ((equal m tok) t)
        ((eq (car m) :and) (or (predicate-narrows-p (second m) tok)
                               (predicate-narrows-p (third m) tok)))
        (t nil)))
(defun module-predicate (m) (or (module-row-policy m) '(:false)))
(defun column-gate (columns requested effective predicates)
  (cond ((> columns 64) (syntax-bad "table_col_count_exceeds_m0_64_ceiling:~D" columns))
        ((not (zerop (logand effective (lognot requested))))
         (syntax-bad "effective_mask_not_subset_of_column_mask"))
        (t (let ((refs 0))
             (dolist (p predicates)
               (let ((r (predicate-columns columns p)))
                 (unless (okp r) (return-from column-gate r))
                 (setf refs (logior refs (result-value r)))))
             (if (zerop (logand refs (lognot effective))) (good refs)
                 (syntax-bad "column_privilege_denied_42501:referenced=~D:effective=~D"
                             refs effective))))))
(defun module-policy-gate (m)
  (let ((ps (cons (module-predicate m) (when (module-where m) (list (module-where m))))))
    (dolist (p ps)
      (let ((r (predicate-bounds p))) (unless (okp r) (return-from module-policy-gate r))))
    (bind-good (refs (column-gate (module-columns m) (module-mask m)
                                  (module-effective-mask m) ps))
      (declare (ignore refs)) (good))))
(defun revocation-gate (tx tok)
  (if (< (capability-epoch tok) (transaction-pin tx)) (bad :stale) (good)))
(defun policy-binding (m tok)
  (let ((mask (effective-mask tok)))
    (if (and (zerop (logand (module-mask m) (lognot mask)))
             (zerop (logand (module-effective-mask m) (lognot mask)))
             (predicate-narrows-p (module-predicate m) (capability-predicate tok)))
        (good) (bad :privilege))))
(defun predicate-value (p row)
  (case (car p)
    (:true (good t)) (:false (good nil))
    ((:literal :columns)
     (let ((a (second p)) (b (fourth p)))
       (if (or (>= a (length row))
               (and (eq (car p) :columns) (>= b (length row)))) (bad :bounds)
           (good (comparison (third p) (nth a row)
                             (if (eq (car p) :columns) (nth b row) b))))))
    (:not (bind-good (a (predicate-value (second p) row)) (good (not a))))
    ((:and :or)
     (bind-good (a (predicate-value (second p) row))
       (bind-good (b (predicate-value (third p) row))
         (good (if (eq (car p) :and) (and a b) (or a b))))))
    (otherwise (syntax-bad "predicate_constructor"))))
(defun allocate-predicate-frames (s n)
  (let ((charge (* 8 (ceiling (* n 16) 8))))
    (if (or (zerop (scratch-cap s)) (zerop n) (> (+ (scratch-used s) charge) (scratch-cap s))) (bad :arena-cap)
        (let ((next (copy-scratch s)))
          (incf (scratch-used next) charge) (good next)))))
(defun run-predicate-loop (fuel depth row scratch work values)
      (let ((state scratch))
        (block computation
          (labels ((charge (n)
                     (let ((r (allocate-predicate-frames state n)))
                       (unless (okp r) (return-from computation r))
                       (setf state (result-value r))))
                   (overflow ()
                     (when (or (> (length work) depth) (> (length values) depth))
                       (return-from computation
                         (syntax-bad "rowPred_eval_stack_overflow:~D" (length work))))))
            (loop while work do
              (when (zerop fuel)
                (return-from computation (syntax-bad "rowPred_eval_fuel_exhausted")))
              (decf fuel) (overflow)
              (let* ((item (pop work)) (kind (car item)) (p (second item)))
                (case kind
                  (:node
                   (case (car p)
                     ((:and :or :not)
                      (push (list (car p) (third p)) work)
                      (push (list :node (second p)) work)
                      (overflow) (charge 2))
                     (otherwise
                      (let ((a (second p)) (b (fourth p)))
                        (when (and (member (car p) '(:literal :columns)) (>= a (length row)))
                          (return-from computation (syntax-bad
                            (if (eq (car p) :literal) "rowPred_colIdx_out_of_bounds:~D"
                                "rowPred_lhsColIdx_out_of_bounds:~D") a)))
                        (when (and (eq (car p) :columns) (>= b (length row)))
                          (return-from computation (syntax-bad "rowPred_rhsColIdx_out_of_bounds:~D" b))))
                      (charge 1)
                      (let ((r (predicate-value p row)))
                        (unless (okp r) (return-from computation r))
                        (push (result-value r) values)))))
                  ((:not :and :or)
                   (unless values (return-from computation (syntax-bad "rowPred_eval_stack_underflow")))
                   (let ((a (pop values)))
                     (charge 1)
                     (case kind
                       (:not (push (not a) values))
                       (:and (if a (push (list :node p) work) (push nil values)))
                       (:or (if a (push t values) (push (list :node p) work)))))))))
            (if (= (length values) 1) (good (list (first values) state))
                (syntax-bad "rowPred_eval_invalid_final_valStack"))))))
(defun run-predicate (row p scratch &optional (depth 16) (nodes 16))
 (bind-good (unit (predicate-bounds p depth nodes)) (declare (ignore unit))
  (bind-good (state (allocate-predicate-frames scratch 1))
   (run-predicate-loop (+ 2 (* 2 nodes)) depth row state (list (list :node p)) nil))))

(deftype predicate-work-item () '(cons (member :node :not :and :or) list))
(defun predicate-list-columns (columns predicates)
 (let ((refs 0))
  (dolist (p predicates (good refs))
   (let ((r (predicate-columns columns p)))
    (unless (okp r) (return-from predicate-list-columns r))
    (setf refs (logior refs (result-value r)))))))


(defun predicate-bounds (p &optional (depth 16) (nodes 16)) (predicate-bounds-with-caps p depth nodes))

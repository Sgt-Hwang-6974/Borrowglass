(in-package :borrowglass)
(defconstant +signed-minimum+ -9223372036854775808)
(defconstant +signed-maximum+ 9223372036854775807)
(defun reason-from-code (code)
  (case code (22012 :zero) (22003 :range) (22020 :bounds) (53300 :connections) (otherwise :arena-cap)))
(defun align-narrow-bytes (n) (* 8 (floor (+ n 7) 8)))
(defun align-wide-bytes (n) (u64 (* 8 (floor (u64 (+ n 7)) 8))))
(defun arena-allocation-class-p (class) (member class '(:session :transaction :plan :row)))
(defun narrow-byte (mode value)
  (if (and (eq mode :checked) (> value 255)) (bad :range) (good (ldb (byte 8 0) value))))
(defun read-word-slice (s i tok) (slice-read s i tok))
(defun read-byte-slice (s i tok) (slice-read s i tok t))
(defun write-word-slice (s i v tok) (slice-write s i v tok))
(defun write-byte-slice (mode s i v tok) (slice-write s i v tok t mode))
(defun row-enter-transition (s cap tok)
  (let ((r (reenter-row s cap tok)))
    (if (okp r) r (bad (result-reason r) (result-detail r) (list s cap tok)))))
(defun row-end-transition (s cap tok)
  (let ((r (end-row s cap tok)))
    (if (okp r) r (bad (result-reason r) (result-detail r) (list s cap tok)))))
(defun checked-arithmetic (op a b)
  (let ((n (ecase op (:add (+ a b)) (:sub (- a b)) (:mul (* a b)))))
    (if (<= (- (ash 1 63)) n (1- (ash 1 63)))
        (list :result-ok (list (scalar :i64 n))) (list :result-error :range))))
(defun guarded-division (op a b)
  (cond ((zerop b) (list :result-error :zero))
        ((and (= a (- (ash 1 63))) (= b -1)) (list :result-error :range))
        (t (multiple-value-bind (q r) (truncate a b)
             (list :result-ok (list (scalar :i64 (ecase op (:div q) (:mod r)))))))))
(defun slice-read (s idx tok &optional bytep)
  (let ((id (if bytep (byte-slice-id s) (word-slice-id s)))
        (epoch (if bytep (byte-slice-epoch s) (word-slice-epoch s)))
        (cap (if bytep (byte-slice-cap s) (word-slice-cap s)))
        (data (if bytep (byte-slice-bytes s) (word-slice-words s))))
    (cond ((or (/= id (witness-id tok)) (/= epoch (witness-epoch tok))) (bad :stale nil tok))
          ((or (>= idx cap) (>= idx (length data))) (bad :bounds nil tok))
          (t (good (list (nth idx data) tok))))))
(defun slice-write (s idx value tok &optional bytep (narrow :truncate))
  (let ((id (if bytep (byte-slice-id s) (word-slice-id s)))
        (epoch (if bytep (byte-slice-epoch s) (word-slice-epoch s)))
        (mode (if bytep (byte-slice-mode s) (word-slice-mode s)))
        (cap (if bytep (byte-slice-cap s) (word-slice-cap s)))
        (data (if bytep (byte-slice-bytes s) (word-slice-words s))))
    (cond ((or (not (eq mode :unique)) (not (eq (witness-mode tok) :unique))
               (/= id (witness-id tok)) (/= epoch (witness-epoch tok)))
           (bad :stale nil (list s tok)))
          ((>= idx cap) (bad :bounds nil (list s tok)))
          ((and bytep (eq narrow :checked) (> value 255)) (bad :range nil (list s tok)))
          ((>= idx (length data)) (bad :bounds nil (list s tok)))
          (t (let ((next (copy-list data)) (ns (copy-structure s)))
               (setf (nth idx next) (if bytep (ldb (byte 8 0) value) value))
               (if bytep (setf (byte-slice-bytes ns) next) (setf (word-slice-words ns) next))
               (good (list ns tok)))))))
(defun arena-allocate (region cap bytes)
  (let* ((aligned (align-narrow-bytes bytes)) (next (u64 (+ (arena-cap-used cap) aligned))))
    (if (or (not (arena-allocation-class-p (arena-cap-class cap)))
            (= bytes 0) (> next (arena-cap-cap cap))) (bad :arena-cap nil cap)
        (let ((nc (copy-arena-cap cap)))
          (setf (arena-cap-used nc) next)
          (good (list (make-byte-slice :region region :id (arena-cap-id cap)
                    :epoch (arena-cap-epoch cap) :mode :unique :cap bytes
                    :bytes (make-list bytes :initial-element 0)) nc))))))
(defun env-value (env name) (cdr (assoc name env :test #'equal)))
(defun env-bind (params values) (mapcar (lambda (p v) (cons (first p) v)) params values))
(defun runtime-witness (name value)
  (case (car value)
    (:cap (let ((c (second value)))
            (make-witness :name name :id (arena-cap-id c) :epoch (arena-cap-epoch c) :mode :unique)))
    (:row-token (let ((r (second value)))
                  (make-witness :name name :id (row-token-id r) :epoch (row-token-epoch r) :mode :unique)))))
(defun interpret-list (fuel m env es)
  (if (zerop fuel) (syntax-bad "eval_fuel_exhausted")
      (if (null es) (good nil)
          (bind-good (v (interpret-expr (1- fuel) m env (car es)))
            (bind-good (vs (interpret-list (1- fuel) m env (cdr es))) (good (cons v vs)))))))
(defun interpret-expr (fuel m env e)
  (when (zerop fuel) (return-from interpret-expr (syntax-bad "eval_fuel_exhausted")))
  (decf fuel)
  (let ((kind (first e)))
    (case kind
      (:var (let ((pair (assoc (second e) env :test #'equal)))
              (if pair (good (cdr pair)) (syntax-bad "runtime_unbound_var:~A" (second e)))))
      ((:i64 :u32 :u64 :bool) (good e))
      ((:arith :div :word32 :word64 :shift :cmp :boolean)
       (bind-good (a (interpret-expr fuel m env (third e)))
         (bind-good (b (interpret-expr fuel m env (fourth e)))
           (let ((op (second e)) (x (second a)) (y (second b)))
             (cond
               ((member kind '(:arith :div))
                (if (and (eq (car a) :i64) (eq (car b) :i64))
                    (good (if (eq kind :arith) (checked-arithmetic op x y) (guarded-division op x y)))
                    (syntax-bad "runtime_arithmetic_type")))
               ((member kind '(:word32 :word64))
                (let ((ty (if (eq kind :word32) :u32 :u64)))
                  (if (and (eq (car a) ty) (eq (car b) ty))
                      (good (scalar ty (ldb (byte (if (eq ty :u32) 32 64) 0)
                                       (ecase op (:add (+ x y)) (:xor (logxor x y))
                                         (:or (logior x y)) (:and (logand x y))))))
                      (syntax-bad "runtime_word_type"))))
               ((eq kind :shift)
                (if (and (eq (car a) :u32) (eq (car b) :u32))
                    (good (if (or (zerop y) (>= y 32)) (list :result-error :range)
                              (list :result-ok (list (scalar :u32
                                (ecase op (:right (ash x (- y))) (:left (u32 (ash x y)))
                                  (:rotate (rotate-word x y))))))))
                    (syntax-bad "runtime_shift_type")))
               ((eq kind :cmp)
                (if (and (eq (car a) (car b)) (member (car a) '(:i32 :i64 :u32 :u64)))
                    (good (scalar :bool (comparison op x y))) (syntax-bad "runtime_comparison_type")))
               ((eq kind :boolean)
                (if (and (eq (car a) :bool) (eq (car b) :bool))
                    (good (scalar :bool (ecase op (:not (not x)) (:and (and x y)) (:or (or x y)))))
                    (syntax-bad "runtime_boolean_type"))))))))
      ((:slice-ref :byte-ref)
       (bind-good (s (interpret-expr fuel m env (second e)))
         (bind-good (idx (interpret-expr fuel m env (third e)))
           (let ((tok (runtime-witness (fourth e) (env-value env (fourth e)))) (bytep (eq kind :byte-ref)))
             (if (and (eq (car s) (if bytep :bytes :words)) (eq (car idx) :u32) (witness-p tok))
                 (let ((r (if bytep (read-byte-slice (second s) (second idx) tok)
                              (read-word-slice (second s) (second idx) tok))))
                   (good (if (okp r) (list :result-ok (list (scalar :u32 (first (result-value r)))))
                             (list :result-error (result-reason r)))))
                 (bad :stale))))))
      (:call
       (bind-good (args (interpret-list fuel m env (third e)))
         (let ((decl (find-function (second e) (module-declarations m))))
           (if (null decl) (syntax-bad "runtime_unresolved_callee:~A" (second e))
               (bind-good (r (interpret-stmt fuel m (env-bind (getf (second decl) :params) args) (third decl)))
                 (case (first r)
                   (:ok (good (list :result-ok (second r))))
                   (:refuse (good (list :result-error (or (third r) (reason-from-code (fifth r))))))
                   (otherwise (syntax-bad "runtime_call_invalid_return"))))))))
      (otherwise (syntax-bad "runtime_expression_constructor")))))
(defun refusal-continuation (fuel m env err branch code)
  (bind-good (r (interpret-stmt fuel m (acons (second err) (scalar :u32 (sqlcode code)) env) branch))
    (good (list (first r) (second r) code (fourth r) (fifth r)))))
(defun interpret-stmt (fuel m env s)
  (when (zerop fuel) (return-from interpret-stmt (syntax-bad "eval_fuel_exhausted")))
  (decf fuel)
  (case (first s)
    (:let (bind-good (v (interpret-expr fuel m env (fourth s)))
            (interpret-stmt fuel m (acons (second s) v env) (fifth s))))
    (:if (bind-good (c (interpret-expr fuel m env (second s)))
           (if (eq (car c) :bool) (interpret-stmt fuel m env (if (second c) (third s) (fourth s)))
               (syntax-bad "runtime_if_cond_type"))))
    (:return (bind-good (vs (interpret-list fuel m env (third s)))
               (good (list (second s) vs nil (scratch-bindings env) (fifth s)))))
    (:match (bind-good (v (interpret-expr fuel m env (second s)))
              (case (car v)
                (:result-ok (interpret-stmt fuel m (append (env-bind (third s) (second v)) env) (fourth s)))
                (:result-error (refusal-continuation fuel m env (fifth s) (sixth s) (second v)))
                (otherwise (syntax-bad "runtime_match_shape")))))
    ((:slice-set :byte-set)
     (destructuring-bind (kind slice-var idx-expr val-expr in-token out-token sql ok err no &optional narrow) s
       (declare (ignore sql))
       (bind-good (idx (interpret-expr fuel m env idx-expr))
         (bind-good (value (interpret-expr fuel m env val-expr))
           (let ((slice (env-value env slice-var)) (tok (env-value env in-token)))
             (if (and (member (car slice) '(:words :bytes)) (eq (car idx) :u32)
                      (eq (car value) :u32) (runtime-witness in-token tok))
                 (let ((r (if (eq kind :byte-set)
                              (write-byte-slice narrow (second slice) (second idx) (second value) (runtime-witness in-token tok))
                              (write-word-slice (second slice) (second idx) (second value) (runtime-witness in-token tok)))))
                   (if (okp r)
                       (interpret-stmt fuel m (acons slice-var (list (car slice) (first (result-value r)))
                                                    (acons out-token tok env)) ok)
                       (refusal-continuation fuel m env err no (result-reason r))))
                 (syntax-bad "runtime_slice_set_shape")))))))
    (:loop
     (destructuring-bind (kind bound depth bindings step after) s
       (declare (ignore kind))
       (if (or (= bound 0) (> depth 64)) (syntax-bad "boundedLoop_invalid_loopVariant")
           (bind-good (vals (interpret-list fuel m env (mapcar #'third bindings)))
              (evaluate-bounded-loop fuel bound m env bindings vals step after (scratch-bindings env))))))
    (:primitive
     (destructuring-bind (kind name args inputs outputs sql ok err no) s
       (declare (ignore kind inputs sql))
       (bind-good (vs (interpret-list fuel m env args))
         (let ((r (run-platform-primitive name vs outputs m env)))
           (if (okp r) (interpret-stmt fuel m (append (env-bind outputs (result-value r)) (or (result-preserved r) env)) ok)
               (refusal-continuation fuel m env err no (result-reason r)))))))
    (otherwise (syntax-bad "runtime_statement_constructor"))))
(defun run-platform-primitive (name vs outputs m env)
  (cond
    ((member name '("bg-row-reenter" "bg-row-end") :test #'equal)
     (if (and (= (length vs) 2) (eq (caar vs) :cap) (eq (car (second vs)) :row-token))
         (let* ((cap (second (first vs))) (row (second (second vs))) (s (find-scratch env (arena-cap-id cap))))
           (if (null s) (bad :stale)
               (bind-good (next (if (equal name "bg-row-reenter") (row-enter-transition s cap row) (row-end-transition s cap row)))
                 (make-result :value (append (list (list :cap (second next)))
                                             (when (third next) (list (list :row-token (third next)))))
                              :preserved (put-scratch (first next) env)))))
         (syntax-bad "runtime_primitive_shape")))
    ((equal name "bg-generation-next")
     (if (and (= (length vs) 1) (eq (caar vs) :u64))
         (bind-good (n (increment-generation (second (first vs)))) (good (list (scalar :u64 n))))
         (syntax-bad "runtime_primitive_shape")))
    ((equal name "bg-arena-allocate")
     (if (and (= (length vs) 2) (eq (caar vs) :cap) (eq (car (second vs)) :u32))
         (bind-good (pair (arena-allocate (second (second (first outputs)))
                                          (second (first vs)) (second (second vs))))
           (let ((s (find-scratch env (arena-cap-id (second pair)))))
             (make-result :value (list (list :bytes (first pair)) (list :cap (second pair)))
               :preserved (if s (let ((ns (copy-scratch s)))
                                  (setf (scratch-used ns) (arena-cap-used (second pair))) (put-scratch ns env)) env))))
         (syntax-bad "runtime_primitive_shape")))
    ((equal name "bg-region-open")
     (let* ((type (second (first outputs)))
            (decl (find (third type) (module-regions m) :key #'region-name :test #'equal))
            (owned (owned-region-ids env)))
       (if (and (null vs) (= (length outputs) 1) decl)
           (bind-good (cap (enter-region decl owned))
             (if (eq (region-class decl) :row)
                 (let* ((old (find-scratch env (region-id decl)))
                        (used (if (and old (= (scratch-epoch old) 0) (<= (scratch-used old) (region-cap decl)))
                                  (scratch-used old) 0))
                        (s (make-scratch :id (region-id decl) :cap (region-cap decl) :used used)))
                   (setf (arena-cap-used cap) used)
                   (make-result :value (list (list :cap cap)) :preserved (put-scratch s env)))
                 (good (list (list :cap cap)))))
           (syntax-bad "runtime_region_open_shape"))))
    ((equal name "bg-token-authenticate")
     (if (and (= (length vs) 3) (every (lambda (v) (eq (car v) :bytes)) vs) (= (length outputs) 1))
         (let* ((slices (mapcar #'second vs))
                (classes '(:static :session :session))
                (coordinates (every (lambda (s class)
                                      (let ((d (find (byte-slice-region s) (module-regions m)
                                                     :key #'region-name :test #'equal)))
                                        (and d (= (region-id d) (byte-slice-id s)) (eq (region-class d) class))))
                                    slices classes)))
           (cond ((not coordinates) (bad :stale))
                 ((some (lambda (s) (/= (length (byte-slice-bytes s)) (byte-slice-cap s))) slices) (bad :bounds))
                 (t (bad :privilege))))
         (syntax-bad "runtime_primitive_shape")))
    (t (syntax-bad "runtime_primitive_shape:~A" name))))
(defun initial-tokens (env)
  (loop for (name . v) in env when (member (car v) '(:cap :row-token)) collect v))
(defun run-program (prog &optional context)
 (let* ((m (program-module prog)) (checked (validate-module m context))
        (initial-env (program-environment prog)) (env (seed-scratches (module-regions m) initial-env))
        (preserved (initial-tokens initial-env)))
  (labels ((refused (phase r &optional vals)
    (make-outcome :kind phase :reason (result-reason r) :detail (result-detail r)
                  :code (sqlcode (result-reason r)) :values vals)))
   (unless (okp checked) (return-from run-program (refused :static checked)))
   (let ((decl (find-function (program-entry prog) (module-declarations m))))
    (unless decl (return-from run-program (refused :static (syntax-bad "missing_entryFn:~A" (program-entry prog)))))
    (let ((resolved (resolve-predicate-scratch (module-regions m) env)))
     (unless (okp resolved) (return-from run-program (refused :runtime resolved preserved)))
     (let ((pred (evaluate-module-predicate m (program-tuple prog) (result-value resolved))))
      (unless (okp pred) (return-from run-program (refused :runtime pred preserved)))
      (unless (first (result-value pred)) (return-from run-program (make-outcome :kind :filtered :values preserved)))
      (let ((scratch (second (result-value pred))))
       (setf env (put-scratch scratch (sync-cap-usage scratch env))))
      (let ((r (interpret-stmt (program-fuel prog) m env (third decl))))
       (unless (okp r) (return-from run-program (refused :runtime r)))
       (let ((rv (result-value r)))
        (case (first rv)
         (:filtered (make-outcome :kind :filtered :values (second rv)))
         (:refuse (let ((reason (or (third rv) (reason-from-code (fifth rv)))))
           (make-outcome :kind :runtime :reason reason :code (or (fifth rv) (sqlcode reason)) :values (second rv))))
         (otherwise (make-outcome :kind :accepted :values (second rv))))))))))))
(defun find-scratch (env id)
  (loop for (name . v) in env when (and (eq (car v) :scratch) (= (scratch-id (second v)) id)) return (second v)))
(defun put-scratch (s env)
  (acons (scratch-binding-name (scratch-id s)) (list :scratch s) env))
(defun scratch-bindings (env) (scratch-bindings-aux nil env))
(defun owned-region-ids (env)
  (remove-duplicates
    (loop for (name . v) in env
          for id = (case (car v)
                     (:cap (arena-cap-id (second v))) (:row-token (row-token-id (second v)))
                     (:bytes (byte-slice-id (second v))) (:words (word-slice-id (second v))))
          when id collect id)))
(defun seed-scratches (decls env)
  (append
    (loop for d in decls when (and (eq (region-class d) :row) (null (find-scratch env (region-id d))))
          append (let ((cap (initial-region-cap env (region-id d))))(when cap (list (cons (scratch-binding-name (region-id d))
                                   (list :scratch (make-scratch :id (region-id d) :cap (region-cap d)
                                                  :used (arena-cap-used cap) :epoch (arena-cap-epoch cap)))))))) env))
(defun sync-cap-usage (s env)
  (mapcar (lambda (pair)
            (let ((v (cdr pair)))
               (if (and (eq (car v) :cap) (eq (arena-cap-class (second v)) :row)
                        (= (arena-cap-id (second v)) (scratch-id s))
                       (= (arena-cap-epoch (second v)) (scratch-epoch s)))
                  (let ((c (copy-arena-cap (second v))))
                    (setf (arena-cap-used c) (scratch-used s)) (cons (car pair) (list :cap c))) pair))) env))


(deftype primitive-outcome () 'result)
(deftype runtime-binding () '(cons string list))
(defun list-at (xs index)
 (if (< index (length xs)) (good (nth index xs)) (bad :bounds)))
(defun list-with (xs index value)
 (if (< index (length xs)) (let ((next (copy-list xs))) (setf (nth index next) value) (good next)) (bad :bounds)))
(defun row-enter-with-state (s cap tok) (row-enter-transition s cap tok))
(defun scratch-binding-name (id) (format nil "__row_scratch_state_~D" id))
(defun scratch-bindings-aux (seen env)
 (loop for pair in env for v = (cdr pair)
  when (and (eq (car v) :scratch) (not (member (scratch-id (second v)) seen)))
  collect (progn (push (scratch-id (second v)) seen) pair)))
(defun initial-region-cap (env id)
 (loop for (name . v) in env when (and (eq (car v) :cap) (= (arena-cap-id (second v)) id)) return (second v)))
(defun bind-loop-values (bindings values) (env-bind bindings values))
(defun first-scratch-declaration (decls) (find :row decls :key #'region-class))
(defun first-scratch-state (env)
 (loop for (name . v) in env when (eq (car v) :scratch) return (second v)))
(defun resolve-predicate-scratch (decls env)
 (let ((s (first-scratch-state env)) (d (first-scratch-declaration decls)))
  (cond (s (good s)) (d (good (make-scratch :id (region-id d) :cap (region-cap d)))) (t (bad :stale)))))
(defun evaluate-module-predicate (m tuple scratch)
 (bind-good (pair (run-predicate tuple (module-predicate m) scratch))
  (if (or (not (first pair)) (null (module-where m))) (good pair)
    (run-predicate tuple (module-where m) (second pair)))))
(defun evaluate-bounded-loop (fuel remaining m env bindings current step after scratches)
 (if (zerop fuel) (syntax-bad "eval_fuel_exhausted")
  (let ((loop-env (append (bind-loop-values bindings current) scratches env)))
   (if (zerop remaining) (interpret-stmt (1- fuel) m loop-env after)
    (bind-good (r (interpret-stmt (1- fuel) m loop-env step))
     (case (first r)
      (:continue (evaluate-bounded-loop (1- fuel) (1- remaining) m env bindings (second r) step after (fourth r)))
      (:exit (interpret-stmt (1- fuel) m (append (bind-loop-values bindings (second r)) (fourth r) env) after))
      (otherwise (good r))))))))



(defun example-select-module ()
 (let ((decl (example-select-declaration)))
  (make-module :name "bg.primitive.memory" :regions
   (list (make-region :name "rStatic" :id 1 :class :static :cap 16777216)
         (make-region :name "rRow" :id 6 :class :row :cap 16777216 :base 16777216))
   :signatures (list (cons (first decl) (second decl))) :declarations (list decl) :row-policy '(:true))))
(defun example-select-program ()
 (make-program :name "fixture-select-two" :module (example-select-module) :entry "fixture-select" :fuel 32
  :environment (list (cons "n_val" '(:i64 2))
   (cons "cap_tok" (list :cap (make-arena-cap :id 6 :class :row :cap 16777216)))

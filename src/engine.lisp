        (helper (list :regions nil :params '(("x" :i64)) :return '(:result (:i64) nil 22003) :effects 0))
        (entry (list :regions '(("rRow" :row :unique)) :params '(("in_val" :i64))
          :return (list :result (list :i64 cap) nil 53200) :effects 1))
        (ds (list
          (list "add-ten" helper '(:match (:arith :add (:var "x" :i64) (:i64 10) 22003)
            (("sum" :i64)) (:return :ok ((:var "sum" :i64)) nil)
            (:error "err" nil) (:return :refuse nil nil 22003)) nil 1)
          (list "initialize-call" entry
            (list :primitive "bg-region-open" nil nil (list (list "cap0" cap)) 53200
              (list :match '(:call "add-ten" ((:var "in_val" :i64))) '(("out_val" :i64))
                (list :return :ok (list '(:var "out_val" :i64) (list :var "cap0" cap)) '("cap0"))
                '(:error "call_err" ("cap0")) (list :return :refuse (list (list :var "cap0" cap)) '("cap0") 22003))
              '(:error "init_err" nil) '(:return :refuse nil nil 53200)) '((:lifetime "rRow" :row :unique)) 1))))
  (make-program :name "fixture-initialize-call" :module
    (make-module :name "bg.primitive.memory" :regions (list (example-row-declaration))
     :signatures (mapcar (lambda (d) (cons (first d) (second d))) ds) :declarations ds :row-policy '(:true))
    :entry "initialize-call" :environment (list (cons "in_val" '(:i64 32))) :fuel 32)))
(defun example-removed-platform (name class mode capacity)
 (let* ((cap '(:token :region-cap "rEnt")) (slice (list :bytes "rEnt" mode capacity))
        (sig (list :regions (list (list "rEnt" class :unique))
          :params (list (list "cap_in" cap) (list "buf32" slice)) :return (list :result (list cap) nil 42501) :effects 1))
        (decl (list "fixture-key-draw" sig
          (list :primitive "bg-platform-random" (list (list :var "cap_in" cap) (list :var "buf32" slice))

(in-package :borrowglass)
(defstruct frame kind (index 0) (request 0) payload)
(defstruct request kind (relation 0) (row 0) (column 0) (value 0))
(defun protocol-bad (why) (bad :protocol why))
(defun parse-frame (bytes)
  (unless (= (length bytes) 128) (return-from parse-frame (protocol-bad :length)))
  (unless (equalp (subseq bytes 0 4) (ascii "BRG1")) (return-from parse-frame (protocol-bad :magic)))
  (unless (= (aref bytes 4) 1) (return-from parse-frame (protocol-bad :version)))
  (unless (and (= (aref bytes 6) 0) (zero-range-p bytes 16 24) (zero-range-p bytes 28 32))
    (return-from parse-frame (protocol-bad :reserved)))
  (let ((kind (aref bytes 5)) (index (aref bytes 7)) (size (get-le bytes 24 4)))
    (cond ((= kind 1)
           (if (and (< index 4) (= size 96))
               (good (make-frame :kind 1 :index index :request (get-le bytes 8 8) :payload (subseq bytes 32)))
               (protocol-bad :fragment)))
          ((member kind '(2 3))
           (if (and (= index 4) (= size 24) (zero-range-p bytes 52 128)
                    (or (= kind 3) (= (get-le bytes 48 4) 0)))
               (good (make-frame :kind kind :index index :request (get-le bytes 8 8)
                     :payload (make-request :kind kind :relation (get-le bytes 32 8)
                               :row (get-le bytes 40 4) :column (get-le bytes 44 4) :value (get-le bytes 48 4))))
               (protocol-bad :command)))
          (t (protocol-bad :kind)))))
(defun encode-frame (kind index id payload)
  (let ((b (octets 128)))
    (replace b (ascii "BRG1")) (setf (aref b 4) 1 (aref b 5) kind (aref b 7) index)
    (put-le b 8 8 id) (put-le b 24 4 (length payload)) (replace b payload :start1 32) b))
(defun request-frames (raw req &optional (id 1))
  (let ((payload (octets 24)))
    (put-le payload 0 8 (request-relation req)) (put-le payload 8 4 (request-row req))
    (put-le payload 12 4 (request-column req)) (put-le payload 16 4 (request-value req))
    (append (loop for i below 4 collect (encode-frame 1 i id (subseq raw (* 96 i) (* 96 (1+ i)))))
            (list (encode-frame (request-kind req) 4 id payload)))))
(defun response-frame (id status phase code &optional value)
  (let ((payload (octets 24)))
    (put-le payload 0 4 status) (put-le payload 4 4 phase) (put-le payload 8 4 code)
    (when (and (= status 0) value) (put-le payload 12 4 value))
    (encode-frame 128 4 id payload)))

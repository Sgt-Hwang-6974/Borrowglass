(in-package :borrowglass)
(defparameter *primitive-names*
  '("bg-arena-allocate" "bg-row-reenter" "bg-region-open" "bg-row-end" "bg-generation-next" "bg-token-authenticate"))
(defun parse-bg (text)
  (when (> (length text) 16384) (return-from parse-bg (syntax-bad "input_byte_limit")))
  (let ((pos 0) (n (length text)))
    (block parse
      (labels ((fail (why) (return-from parse (syntax-bad "reader:~A:~D" why pos)))
               (spacep (c) (member (char-code c) '(9 10 13 32)))
               (skip ()
                 (loop while (< pos n) do
                   (cond ((spacep (char text pos)) (incf pos))
                         ((char= (char text pos) #\;) (loop while (and (< pos n) (char/= (char text pos) #\Newline)) do (incf pos)))
                         (t (return)))))
               (node (depth)
                 (skip)
                 (when (> depth 64) (fail "depth_limit"))
                 (when (>= pos n) (fail "unexpected_end"))
                 (let ((c (char text pos)))
                   (cond
                     ((char= c #\() (incf pos)
                      (let ((items nil))
                        (loop (skip) (when (>= pos n) (fail "unterminated_list"))
                          (when (char= (char text pos) #\)) (incf pos) (return (nreverse items)))
                          (push (node (1+ depth)) items))))
                     ((char= c #\)) (fail "unexpected_close"))
                     (t (let ((start pos))
                          (loop while (and (< pos n) (not (spacep (char text pos)))
                                           (not (find (char text pos) "();"))) do
                            (let ((code (char-code (char text pos))))
                              (unless (or (<= 48 code 57) (<= 65 code 90) (<= 97 code 122)
                                          (find (char text pos) "_-+.*=<>/")) (fail "invalid_atom_character")))
                            (incf pos) (when (> (- pos start) 128) (fail "atom_limit")))
                          (when (= start pos) (fail "empty_atom"))
                          (subseq text start pos)))))))
        (when (some (lambda (c) (> (char-code c) 127)) text) (fail "non_ascii"))
        (let ((form (node 0))) (skip)
          (if (= pos n) (good form) (syntax-bad "reader:trailing_input")))))))
(defun duplicate-name (names)
  (loop for tail on names when (member (car tail) (cdr tail) :test #'equal) return (car tail)))
(defun consume-tokens (names live)
 (let ((rest live))
  (dolist (name names (good rest))
   (let ((r (remove-one-token name rest)))
    (unless (okp r) (return-from consume-tokens r)) (setf rest (result-value r))))))
(defun token-match (names live)
  (let ((dup (or (duplicate-name names) (duplicate-name live))))
    (if dup (syntax-bad "duplicated_linear_token:~A" dup)
        (bind-good (remaining (remove-preserved names live))
          (if remaining (syntax-bad "unconsumed_or_dropped_linear_token:~A" (first remaining)) (good))))))
(defun no-shadow (names env live)
  (let ((dup (duplicate-name names)))
    (cond (dup (syntax-bad "duplicate_binding:~A" dup))
          (t (let ((shadow (find-if (lambda (n) (or (assoc n env :test #'equal) (member n live :test #'equal))) names)))
               (if shadow (syntax-bad "shadowed_binding_or_live_token:~A" shadow) (good)))))))
(defun expr-tokens (e)
  (case (first e)
    (:var (when (linear-type-p (third e)) (list (second e))))
    ((:i64 :u32 :u64 :bool) nil)
    ((:arith :div :word32 :word64 :shift :cmp :boolean)
     (append (expr-tokens (third e)) (expr-tokens (fourth e))))
    (:call (expression-token-list (third e)))
    ((:slice-ref :byte-ref) (append (expr-tokens (second e)) (expr-tokens (third e))))))
(defun check-expressions (signatures env live es)
  (let ((types nil))
    (dolist (e es (good (nreverse types)))
      (let ((r (check-expression signatures env live e)))
        (unless (okp r) (return-from check-expressions r))
        (push (result-value r) types)))))
(defun check-expression (signatures env live e)
  (case (first e)
    (:var (let* ((name (second e)) (actual (assoc name env :test #'equal)))
            (cond ((null actual) (syntax-bad "unbound_var:~A" name))
                  ((not (equal (second actual) (third e))) (syntax-bad "var_type_mismatch:~A" name))
                  ((and (linear-type-p (third e)) (not (member name live :test #'equal))) (bad :stale))
                  (t (good (second actual))))))
    ((:i64 :u32 :u64 :bool) (good (first e)))
    ((:arith :div :word32 :word64 :shift :cmp :boolean)
     (when (and (eq (first e) :shift) (/= (fifth e) 32))
       (return-from check-expression (syntax-bad "shift_width_must_be_32")))
     (bind-good (a (check-expression signatures env live (third e)))
       (bind-good (b (check-expression signatures env live (fourth e)))
         (let* ((kind (first e))
                (ty (case kind ((:arith :div) :i64) ((:word32 :shift) :u32)
                      (:word64 :u64) (:boolean :bool) (:cmp a))))
           (if (and (equal a ty) (equal b ty) (or (not (eq kind :cmp)) (member ty '(:i32 :i64 :u32 :u64))))
               (good (case kind
                       ((:arith :div) (list :result (list :i64) nil (fifth e)))
                       (:shift (list :result (list :u32) nil (sixth e)))
                       ((:cmp :boolean) :bool) (otherwise ty)))
                (syntax-bad (case kind
                  (:arith "checkedArithI64_requires_i64") (:div "guardedDivModI64_requires_i64")
                  (:word32 "wordOpU32_requires_u32") (:word64 "wordOpU64_requires_u64")
                  (:shift "guardedShiftU32_requires_u32") (:cmp "cmpOp_requires_matching_scalar_int")
                  (:boolean "boolOp_requires_bool"))))))))
    ((:slice-ref :byte-ref)
     (when (or (expr-tokens (second e)) (expr-tokens (third e)))
       (return-from check-expression (syntax-bad "slice_ref_args_cannot_move_linear_token")))
     (unless (member (fourth e) live :test #'equal) (return-from check-expression (bad :stale)))
     (bind-good (slice (check-expression signatures env live (second e)))
       (bind-good (idx (check-expression signatures env live (third e)))
         (let ((tok (second (assoc (fourth e) env :test #'equal))))
           (cond
             ((and (consp slice) (eq (car slice) (if (eq (car e) :byte-ref) :bytes :words))
                   (eq idx :u32) (linear-type-p tok))
              (cond ((not (eq (second tok) :borrow)) (syntax-bad "slice_ref_requires_borrow_token"))
                    ((not (equal (third tok) (second slice))) (bad :stale))
                    (t (good (list :result (list :u32) nil (fifth e))))))
             (t (syntax-bad "slice_ref_requires_matching_slice_index_token")))))))
    (:call
     (let ((sig (assoc (second e) signatures :test #'equal)))
       (if (null sig) (syntax-bad "unresolved_callee:~A" (second e))
           (let* ((s (cdr sig)) (ret (getf s :return)) (params (getf s :params)))
             (cond ((or (not (zerop (getf s :effects 0))) (some (lambda (p) (linear-type-p (second p))) params))
                    (syntax-bad "call_requires_pure_non_linear_callee:~A" (second e)))
                   ((or (not (consp ret)) (not (eq (car ret) :result)) (third ret))
                    (syntax-bad "call_requires_nonfiltered_result"))
                   ((some #'linear-type-p (second ret)) (syntax-bad "call_cannot_return_linear_token"))
                   (t (bind-good (tys (check-expressions signatures env live (third e)))
                        (if (equal tys (mapcar #'second params)) (good ret) (syntax-bad "call_arg_type_mismatch")))))))))
    (otherwise (syntax-bad "expression_constructor"))))
(defun check-statement (signatures sig loop-bindings env live stmt)
  (labels ((again (s &optional (e env) (l live)) (check-statement signatures sig loop-bindings e l s))
           (both (a b ea la eb lb)
             (bind-good (unit (again a ea la)) (declare (ignore unit)) (again b eb lb))))
    (case (first stmt)
      (:let
       (destructuring-bind (tag name ty rhs next) stmt
         (declare (ignore tag))
         (when (and (consp ty) (eq (car ty) :result))
           (return-from check-statement (syntax-bad "result_must_use_match:~A" name)))
         (bind-good (actual (check-expression signatures env live rhs))
           (cond ((or (and (consp ty) (eq (car ty) :result)) (and (consp actual) (eq (car actual) :result)))
                  (syntax-bad "result_must_use_match:~A" name))
                 ((not (equal actual ty)) (syntax-bad "letBind_type_mismatch:~A" name))
                 (t (let ((moved (expr-tokens rhs)))
                      (when (duplicate-name moved) (return-from check-statement (syntax-bad "duplicated_linear_token:~A" (duplicate-name moved))))
                      (bind-good (remaining (consume-tokens moved live))
                        (bind-good (unit (no-shadow (list name) env remaining))
                          (declare (ignore unit))
                          (again next (cons (list name ty) env)
                                 (append remaining (when (linear-type-p ty) (list name))))))))))))
      (:if
       (when (expr-tokens (second stmt)) (return-from check-statement (syntax-bad "if_cond_cannot_move_linear_token")))
       (bind-good (ty (check-expression signatures env live (second stmt)))
         (if (eq ty :bool) (both (third stmt) (fourth stmt) env live env live)
             (syntax-bad "if_cond_must_be_bool"))))
      (:match
       (destructuring-bind (tag expr binds yes err no) stmt
         (declare (ignore tag))
         (when (expr-tokens expr) (return-from check-statement (syntax-bad "match_cannot_move_linear_token")))
         (bind-good (ty (check-expression signatures env live expr))
           (if (and (consp ty) (eq (car ty) :result) (equal (mapcar #'second binds) (second ty)))
               (bind-good (unit (no-shadow (mapcar #'first binds) env live))
                 (declare (ignore unit))
                 (bind-good (unit (no-shadow (list (second err)) env live))
                   (declare (ignore unit))
                   (bind-good (unit (token-match (third err) live))
                     (declare (ignore unit))
                     (both yes no (append binds env)
                       (append live (mapcar #'first (remove-if-not (lambda (p) (linear-type-p (second p))) binds)))
                       (cons (list (second err) :u32) env) live))))
               (syntax-bad "match_result_shape")))))
      ((:slice-set :byte-set)
       (destructuring-bind (tag var idx value in out sql yes err no &optional narrow) stmt
         (declare (ignore sql narrow))
         (let ((slice (second (assoc var env :test #'equal))) (tok (second (assoc in env :test #'equal))))
           (when (or (expr-tokens idx) (expr-tokens value)) (return-from check-statement (syntax-bad "set_args_cannot_move_linear_token")))
           (bind-good (it (check-expression signatures env live idx))
             (bind-good (vt (check-expression signatures env live value))
               (unless (and (consp slice) (eq (car slice) (if (eq tag :slice-set) :words :bytes))
                            (eq (third slice) :unique) (eq it :u32) (eq vt :u32)
                            (linear-type-p tok))
                 (return-from check-statement (syntax-bad "set_type_or_mutability_mismatch")))
                (unless (eq (second tok) :mut-borrow)
                  (return-from check-statement (syntax-bad "slice_set_requires_mut_borrow")))
                (unless (equal (third tok) (second slice))
                  (return-from check-statement (bad :stale)))
               (bind-good (rest (consume-tokens (list in) live))
                 (bind-good (unit (no-shadow (list out) env rest)) (declare (ignore unit))
                   (bind-good (unit (no-shadow (list (second err)) env live)) (declare (ignore unit))
                     (bind-good (unit (token-match (third err) live)) (declare (ignore unit))
                       (both yes no (cons (list out tok) env) (append rest (list out))
                             (cons (list (second err) :u32) env) live))))))))))
      (:primitive
       (destructuring-bind (tag name args inputs outputs sql yes err no) stmt
         (declare (ignore tag sql))
         (unless (member name *primitive-names* :test #'equal)
           (return-from check-statement (syntax-bad "unresolved_primitive:~A" name)))
         (when (duplicate-name inputs)
           (return-from check-statement (syntax-bad "duplicated_linear_token:~A" (duplicate-name inputs))))
         (bind-good (unit (token-match (mapcan #'expr-tokens args) inputs))
           (declare (ignore unit))
           (bind-good (types (check-expressions signatures env live args))
             (bind-good (unit (primitive-contract name (getf sig :regions) loop-bindings types inputs outputs env))
               (declare (ignore unit))
               (unless (equal (mapcan #'expr-tokens args) inputs)
                 (return-from check-statement (syntax-bad "primitive_arg_token_order_mismatch")))
               (bind-good (remaining (consume-tokens inputs live))
                 (bind-good (unit (no-shadow (mapcar #'first outputs) env remaining))
                   (declare (ignore unit))
                   (bind-good (unit (no-shadow (list (second err)) env live))
                     (declare (ignore unit))
                     (bind-good (unit (token-match (third err) live))
                       (declare (ignore unit))
                       (let ((locks (when (equal name "bg-region-open")
                                      (list (list (concatenate 'string "__init_attempted_" (first (first outputs))) (second (first outputs)))))))
                         (both yes no (append outputs env)
                           (append remaining (mapcar #'first (remove-if-not (lambda (p) (linear-type-p (second p))) outputs)))
                           (cons (list (second err) :u32) (append locks env)) live)))))))))))
      (:return
       (let* ((mode (second stmt)) (es (third stmt)) (names (fourth stmt))
              (used (mapcan #'expr-tokens es)) (ret (getf sig :return)))
         (when (duplicate-name used)
           (return-from check-statement (syntax-bad "duplicated_linear_token:~A" (duplicate-name used))))
         (bind-good (unit (token-match names live)) (declare (ignore unit))
           (bind-good (unit (token-match used live)) (declare (ignore unit))
             (unless (equal used names) (return-from check-statement (syntax-bad "return_token_order_mismatch")))
             (bind-good (types (check-expressions signatures env live es))
               (if (not (and (consp ret) (eq (car ret) :result))) (syntax-bad "fn_return_must_be_result")
                   (case mode
                     (:ok (if (equal types (second ret)) (good) (syntax-bad "return_ok_type_mismatch")))
                     (:filtered (if (and (third ret) (equal types (remove-if-not #'linear-type-p (second ret))))
                                    (good) (syntax-bad "return_filtered_type_mismatch")))
                     (:refuse (if (or (equal types (remove-if-not #'linear-type-p (second ret)))
                                      (equal types (mapcar #'second (remove-if-not (lambda (p) (linear-type-p (second p))) (getf sig :params)))))
                                  (good) (syntax-bad "return_refusal_type_mismatch")))
                     ((:continue :exit)
                      (if (and loop-bindings (equal types (mapcar #'second (cdr loop-bindings))))
                          (good) (syntax-bad "loop_return_type_mismatch")))
                     (otherwise (syntax-bad "return_mode")))))))))
       (:loop
        (destructuring-bind (tag bound depth binds step after) stmt
         (declare (ignore tag))
         (if (or (zerop bound) (> depth 64)) (syntax-bad "boundedLoop_invalid_loopVariant")
          (bind-good (pair (initialize-loop-bindings signatures env live binds))
           (bind-good (unit (check-statement signatures sig (cons :active binds) (first pair) (second pair) step))
            (declare (ignore unit)) (again after (first pair) (second pair)))))))
      (otherwise (syntax-bad "statement_constructor")))))
(defun raw-form-p (form)
  (and (consp form) (or (member (car form) '(:slice-ref :byte-ref :slice-set :byte-set :primitive))
                       (some #'raw-form-p form))))
(defun validate-module (m &optional context)
 (when context
   (let ((r (revocation-gate (first context) (second context)))) (unless (okp r) (return-from validate-module r)))
   (let ((r (policy-binding m (second context)))) (unless (okp r) (return-from validate-module r))))
 (unless (module-reader-closed m) (return-from validate-module (syntax-bad "macros_or_reader_extensions_forbidden")))
 (bind-good (unit (companion-gate m)) (declare (ignore unit))
   (bind-good (budget (validate-regions (module-regions m))) (declare (ignore budget))
     (bind-good (unit (validate-signature-table (module-signatures m) (module-declarations m)))
       (declare (ignore unit))
       (bind-good (unit (module-policy-gate m)) (declare (ignore unit))
         (validate-declarations (module-regions m) (module-signatures m) (module-declarations m)))))))
(defun read-number (text low high)
  (let ((n (ignore-errors (parse-integer text :junk-allowed nil))))
    (unless (and n (<= low n high)) (error "invalid bounded integer: ~A" text)) n))
(defun scalar-source-expression (form)
  (unless (and (consp form) (stringp (car form))) (error "expression syntax"))
  (let ((tag (car form)))
    (cond ((equal tag "i64") (list :i64 (read-number (second form) (- (ash 1 63)) (1- (ash 1 63)))))
          ((equal tag "u32") (list :u32 (read-number (second form) 0 #xffffffff)))
          ((equal tag "u64") (list :u64 (read-number (second form) 0 #xffffffffffffffff)))
          ((equal tag "bool") (cond ((equal (second form) "true") '(:bool t))
                                    ((equal (second form) "false") '(:bool nil)) (t (error "bool syntax"))))
          ((member tag '("add" "sub" "mul" "div" "mod") :test #'equal)
           (let ((op (cdr (assoc tag '(("add" . :add) ("sub" . :sub) ("mul" . :mul) ("div" . :div) ("mod" . :mod)) :test #'equal))))
             (list (if (member op '(:div :mod)) :div :arith) op
                   (source-expression (third form)) (source-expression (fourth form))
                   (if (member op '(:div :mod)) 22012 22003) 22003)))
          (t (error "unsupported expression form: ~A" tag)))))
(defun fixture-expression-program (expression)
  (let* ((wrapped (member (car expression) '(:arith :div :shift)))
         (type (if wrapped (if (eq (car expression) :shift) :u32 :i64) (car expression)))
         (sig (list :params nil :return (list :result (list type) nil 22003) :effects 0))
         (body (if wrapped
                   (list :match expression (list (list "result" type))
                     (list :return :ok (list (list :var "result" type)) nil)
                     '(:error "error-code" nil) '(:return :refuse nil nil))
                   (list :return :ok (list expression) nil)))
         (m (make-module :name "bg.example" :row-policy '(:true)
                :regions (list (make-region :name "scratch" :id 6 :class :row :cap 1024))
                :signatures (list (cons "entry" sig)) :declarations (list (list "entry" sig body)))))
    (make-program :name "expression-fixture" :module m :entry "entry")))
(defun scalar-source-program (text)
  (bind-good (form (parse-bg text))
    (handler-case
        (if (and (equal (first form) "program") (= (length form) 2))
            (good (fixture-expression-program (source-expression (second form))))
            (syntax-bad "expected_program_expression"))
      (error (e) (syntax-bad "program_syntax:~A" e)))))
(defun primitive-home (name)
  (when (member name *primitive-names* :test #'equal)
    (if (equal name "bg-token-authenticate") "bg.primitive.crypto" "bg.primitive.memory")))
(defun ast-find (predicate tree)
  (when (consp tree)
    (or (and (funcall predicate tree) tree)
        (loop for child in tree thereis (ast-find predicate child)))))
(defun companion-gate (m)
 (let ((direct (direct-call-in-declarations (module-declarations m))))
  (when direct (return-from companion-gate (syntax-bad "companion_primitive_gate_c_shim_rejected:~A:~A" (module-name m) direct))))
 (let ((raw (disallowed-in-declarations (module-name m) (module-declarations m))))
  (if raw (syntax-bad "companion_primitive_gate_rejected:~A:~A" (module-name m) raw) (good))))
(defun mentions-region-p (ty region)
  (and (consp ty)
       (case (car ty)
         ((:bytes :words) (equal (second ty) region))
         (:token (equal (third ty) region))
         (:result (types-mention-region-p (second ty) region)))))
(defun primitive-contract (name regions loop-context types inputs outputs env)
  (let ((out (mapcar #'second outputs)))
    (labels ((region-param (r) (assoc r regions :test #'equal))
             (tokenp (ty kind) (and (consp ty) (eq (car ty) :token) (eq (second ty) kind)))
             (shape () (syntax-bad "primitive_arity_or_type_mismatch:~A" name)))
      (cond
        ((equal name "bg-generation-next")
         (if (and (equal types '(:u64)) (null inputs) (equal out '(:u64))) (good) (shape)))
        ((equal name "bg-region-open")
         (cond (loop-context (syntax-bad "region_open_forbidden_in_loop"))
               ((not (and (null types) (null inputs) (= (length out) 1) (tokenp (first out) :region-cap))) (shape))
               (t (let ((r (third (first out))))
                    (cond ((null (region-param r)) (syntax-bad "region_open_undeclared_region:~A" r))
                          ((some (lambda (p) (mentions-region-p (second p) r)) env)
                           (syntax-bad "region_open_region_already_owned:~A" r))
                          (t (good)))))))
        ((member name '("bg-row-reenter" "bg-row-end") :test #'equal)
         (if (not (and (= (length types) 2) (= (length inputs) 2)
                       (= (length out) (if (equal name "bg-row-reenter") 2 1))
                       (tokenp (first types) :region-cap) (tokenp (second types) :row-borrow)
                       (tokenp (first out) :region-cap)
                       (or (equal name "bg-row-end") (tokenp (second out) :row-borrow)))) (shape)
             (let* ((r (third (first types))) (rp (region-param r)))
               (if (and rp (eq (second rp) :row)
                        (equal (second (assoc (first inputs) env :test #'equal)) (first types))
                        (equal (second (assoc (second inputs) env :test #'equal)) (second types))
                        (equal (third (second types)) r) (equal (third (first out)) r)
                        (or (equal name "bg-row-end") (equal (third (second out)) r))) (good) (bad :stale)))))
        ((equal name "bg-arena-allocate")
         (if (not (and (= (length types) 2) (= (length inputs) 1) (= (length out) 2)
                       (tokenp (first types) :region-cap) (eq (second types) :u32)
                       (consp (first out)) (eq (caar out) :bytes) (eq (third (first out)) :unique)
                       (tokenp (second out) :region-cap))) (shape)
             (let* ((r (third (first types))) (rp (region-param r)))
               (if (and rp (member (second rp) '(:row :plan :session :transaction))
                        (equal (second (assoc (first inputs) env :test #'equal)) (first types))
                        (equal (second (first out)) r) (equal (third (second out)) r)) (good) (bad :stale)))))
        ((equal name "bg-token-authenticate")
         (cond ((not (and (= (length types) 3) (every (lambda (ty) (and (consp ty) (eq (car ty) :bytes))) types)
                           (null inputs) (= (length out) 1))) (shape))
                ((not (equal out '(:bool))) (syntax-bad "authenticate_must_bind_boolean"))
               ((or (/= (fourth (first types)) 32) (not (member (fourth (third types)) '(32 64)))) (bad :privilege))
               (t (let ((params (mapcar (lambda (ty) (region-param (second ty))) types)))
                    (cond ((not (every #'identity params)) (syntax-bad "token_authenticate_undeclared_region"))
                          ((equal (mapcar #'second params) '(:static :session :session)) (good))
                          (t (bad :stale)))))))
        (t (syntax-bad "unresolved_primitive:~A" name))))))
(defun check-region-annotations (m params annotations)
 (bind-good (unit (function-region-parameters (module-regions m) params))
   (declare (ignore unit)) (validate-annotations params annotations)))

(defun source-shape (form size)
  (unless (and (listp form) (= (length form) size)) (error "form arity: ~S" form)) form)
(defun source-name (s)
  (unless (and (stringp s) (plusp (length s))) (error "identifier required")) s)
(defun source-enum (s choices)
  (or (cdr (assoc s choices :test #'equal)) (error "unknown enum: ~S" s)))
(defun source-mode (s)
  (source-enum s '(("shared" . :shared) ("unique" . :unique) ("consume" . :consume))))
(defun source-class (s)
  (source-enum s '(("static" . :static) ("pool" . :pool) ("session" . :session)
                   ("transaction" . :transaction) ("plan" . :plan) ("row" . :row))))
(defun source-bool (s)
  (cond ((equal s "true") t) ((equal s "false") nil) (t (error "boolean required"))))
(defun source-unsigned (s &optional (bits 32)) (read-number s 0 (1- (ash 1 bits))))
(defun source-type (f)
  (if (stringp f)
      (source-enum f '(("i32" . :i32) ("i64" . :i64) ("u32" . :u32) ("u64" . :u64) ("bool" . :bool)))
      (cond
        ((member (car f) '("bytes" "words") :test #'equal)
         (source-shape f 4)

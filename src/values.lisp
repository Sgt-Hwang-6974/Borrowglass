(in-package :borrowglass)
(defstruct result (kind :ok) value reason detail preserved)
(defun good (&optional value) (make-result :value value))
(defun bad (reason &optional detail preserved)
  (make-result :kind :refusal :reason reason :detail detail :preserved preserved))
(defun okp (r) (eq (result-kind r) :ok))
(defun sqlcode (reason)
  (case reason
    ((:arena-cap :generation :stale) 53200) (:connections 53300)
    (:bounds 22020) (:range 22003) (:zero 22012) (:syntax 42601)
    (:privilege 42501) (otherwise 42601)))
(defun syntax-bad (control &rest args) (bad :syntax (apply #'format nil control args)))
(defmacro bind-good ((name expression) &body body)
  `(let ((,name ,expression))
     (if (okp ,name) (let ((,name (result-value ,name))) ,@body) ,name)))
(defstruct capability (version 1) (key-id (octets 8)) (subject 0) (relation 0)
  (mask 0) (predicate '(:true)) (privileges 1) (not-before 0) (expiry 0)
  (serial 0) (epoch 0) caveats (tag (octets 32)))
(defstruct caveat (mask 0) (expiry 0))
(defstruct region name (id 0) class (cap 0) (base 0))
(defstruct arena-cap (id 0) class (cap 0) (epoch 0) (used 0))
(defstruct scratch (op 1) (id 0) (cap 0) (used 0) (epoch 0))
(defstruct row-token (op 1) (id 0) (epoch 0))
(defstruct witness name (id 0) (epoch 0) (mode :shared))
(defstruct word-slice region (id 0) (epoch 0) (mode :shared) (cap 0) words)
(defstruct byte-slice region (id 0) (epoch 0) (mode :shared) (cap 0) bytes)
(defstruct transaction (id 0) (epoch 0) (pin 0) (session 0) (active 0))
(defstruct floor-entry (relation 0) (minimum 0) occupied)
(defstruct pool (id 0) (count 0) (slot-bytes 0) (cap 0) slots)
(defstruct buffer-pin (slot 0) (generation 0) (frame-region 0))
(defstruct pool-handle (pool 0) (slot 0) (generation 0))
(defstruct static-storage (id 0) (base 0) (cap 0) (length 0))
(defstruct session-arena (session 0) (id 0) (cap 0) (used 0) (epoch 0)
  (rx-cap 0) (tx-cap 0) transaction)
(defstruct plan-arena (query 0) (id 0) (cap 0) (used 0) (depth 0) (epoch 0))
(deftype token-kind () '(member :region-cap :row-borrow :buffer-pin :pool-handle :borrow :mut-borrow))
(deftype borrow-mode () '(member :shared :unique :consume))
(deftype mutability () 'borrow-mode)
(deftype allocation-class () '(member :static :pool :session :transaction :plan :row))
(deftype refusal-reason () '(member :arena-cap :generation :stale :connections :bounds :range :zero :syntax :privilege))
(deftype arithmetic-op () '(member :add :sub :mul))
(deftype division-op () '(member :div :mod))
(deftype narrow-word-op () '(member :add :xor :or :and))
(deftype wide-word-op () '(member :add :xor :or :and))
(deftype shift-direction () '(member :right :left :rotate))
(deftype comparison-op () '(member :eq :ne :lt :le :gt :ge))
(deftype boolean-op () '(member :not :and :or))
(deftype byte-narrowing () '(member :truncate :checked))
(deftype return-mode () '(member :ok :filtered :refuse :continue :exit))
(deftype primitive-kind () '(member :allocate :reenter :open :end :increment :authenticate))
(defun type-width (ty) (case ty ((:i32 :u32) 32) ((:i64 :u64) 64)))
(defun type-scalar-integer-p (ty) (not (null (type-width ty))))
(defun token-type-region (ty) (when (and (consp ty) (eq (first ty) :token)) (cdr ty)))
(defun type-equal (a b) (equal a b))
(defun type-list-equal (a b) (equal a b))
(defstruct module name regions signatures declarations (reader-closed t)
  (columns 64) (mask #xffffffffffffffff) (effective-mask #xffffffffffffffff)
  row-policy where)
(defstruct program name module entry environment tuple (fuel 1024))
(defstruct outcome kind reason detail (code 0) values)
(defun scalar (kind value) (list kind value))
(defun linear-type-p (ty) (and (consp ty) (eq (car ty) :token)))
(defun comparison (op a b)
  (ecase op (:eq (= a b)) (:ne (/= a b)) (:lt (< a b))
    (:le (<= a b)) (:gt (> a b)) (:ge (>= a b))))

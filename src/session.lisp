(in-package :borrowglass)
(defstruct session challenge pending-id (next-index 0) fragments (frames 0) (bytes 0))
(defun clear-pending (s)
  (setf (session-pending-id s) nil (session-next-index s) 0 (session-fragments s) nil))
(defun session-frame (s bytes)
  (incf (session-frames s)) (incf (session-bytes s) (length bytes))
  (let* ((r (parse-frame bytes)) (id (if (>= (length bytes) 16) (get-le bytes 8 8) 0)))
    (labels ((error-response () (clear-pending s) (response-frame id 3 1 42601)))
      (unless (okp r) (return-from session-frame (error-response)))
      (let ((frame (result-value r)))
        (cond
          ((= (frame-kind frame) 1)
           (unless (and (= (frame-index frame) (session-next-index s))
                        (or (null (session-pending-id s)) (= id (session-pending-id s))))
             (return-from session-frame (error-response)))
           (setf (session-pending-id s) id)
           (push (frame-payload frame) (session-fragments s)) (incf (session-next-index s)) nil)
          (t
           (unless (and (= (session-next-index s) 4) (session-pending-id s)
                        (= id (session-pending-id s))) (return-from session-frame (error-response)))
           (let ((raw (apply #'cat-bytes (reverse (session-fragments s)))))
             (clear-pending s)
             (destructuring-bind (status phase code value)
                 (ledger-operation (session-challenge s) raw (frame-payload frame))
               (response-frame id (case status (:accepted 0) (:filtered 2) (otherwise 1)) phase code value)))))))))
(defun serve-frame-stream (in-stream out-stream state &key (max-operations 1024))
  (unless (<= 1 max-operations 1048576) (error "operation_limit"))
  (unwind-protect
       (loop repeat max-operations do
         (let ((bytes (octets 128)) (count 0))
           (loop for byte = (read-byte in-stream nil nil) while byte do
             (setf (aref bytes count) byte) (incf count) (when (= count 128) (return)))
           (when (= count 0) (return))
           (let ((response (session-frame state (if (= count 128) bytes (subseq bytes 0 count)))))
             (when response (write-sequence response out-stream)))
           (when (< count 128) (return))))
    (clear-pending state) (finish-output out-stream))
  (list (session-frames state) (session-bytes state)))

(defun exercise-stream (bytes state &key (max-operations 1024))
  (check-type bytes (vector (unsigned-byte 8)))
  (unless (<= 1 max-operations 1048576) (error "operation_limit"))
  (let ((s (make-session :challenge state)) (responses nil))
    (unwind-protect
         (loop for start from 0 below (length bytes) by 128
               repeat max-operations do
           (let ((response (session-frame s (subseq bytes start (min (+ start 128) (length bytes))))))
             (when response (push response responses))))
      (clear-pending s))
    (apply #'cat-bytes (nreverse responses))))

(defun fixture-entropy (seed)
  (apply #'cat-bytes (loop for n below 3 collect
                      (blake2s (cat-bytes (ascii "BORROWGLASS-PUBLIC-FIXTURE-V1")
                                         (pack-le seed 8) (pack-le n 8))))))
(defun fixture-challenge (seed)
  (initialize-challenge (fixture-entropy seed) (constantly 1700000000)))
(defun fixture-transcript (&optional (seed 1101))
  (let* ((state (fixture-challenge seed))
         (bytes (apply #'cat-bytes
                  (append (request-frames (first (challenge-tokens state))
                             (make-request :kind 3 :relation 7 :row 0 :column 1 :value 901))
                          (request-frames (first (challenge-tokens state))
                             (make-request :kind 2 :relation 7 :row 0 :column 1))
                          (request-frames (second (challenge-tokens state))
                             (make-request :kind 3 :relation 7 :row 1 :column 1 :value 999)))))
         (response (exercise-stream bytes state)) (header (octets 32)))
    (replace header (ascii "BGT1")) (put-le header 4 4 1) (put-le header 8 8 seed)
    (put-le header 16 8 1700000000) (put-le header 24 4 (length bytes))
    (put-le header 28 4 (length response)) (cat-bytes header bytes response)))
(defun verify-transcript-bytes (b)
  (check-type b (vector (unsigned-byte 8)))
  (unless (and (>= (length b) 32) (<= (length b) 8388608)
               (equalp (subseq b 0 4) (ascii "BGT1"))
               (= (get-le b 4 4) 1) (= (get-le b 16 8) 1700000000))
    (error "transcript_header"))
  (let ((n (get-le b 24 4)) (m (get-le b 28 4)) (seed (get-le b 8 8)))
    (unless (= (+ 32 n m) (length b)) (error "transcript_length"))
    (let ((out (exercise-stream (subseq b 32 (+ 32 n)) (fixture-challenge seed)
                                :max-operations 65536)))
      (unless (equalp out (subseq b (+ 32 n))) (error "replay_response_bytes"))
      (values out (ceiling n 128)))))

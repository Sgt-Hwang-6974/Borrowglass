(defparameter *borrowglass-root* (make-pathname :name nil :type nil :defaults *load-truename*))
(load (merge-pathnames "src/package.lisp" *borrowglass-root*))
(in-package :borrowglass)
(setf *root* cl-user::*borrowglass-root*)
(defun read-file-bytes (path &optional limit)
  (with-open-file (s path :element-type '(unsigned-byte 8))
    (let ((n (file-length s)))
      (when (and limit (> n limit)) (error "file_size_limit"))
      (let ((b (octets n))) (unless (= n (read-sequence b s)) (error "short_file_read")) b))))
(defun write-file-bytes (path bytes)
  (with-open-file (s path :direction :output :element-type '(unsigned-byte 8)
                    :if-exists :supersede :if-does-not-exist :create) (write-sequence bytes s)))
(defun unix-time () (- (get-universal-time) 2208988800))
(defvar *entropy-path* nil)
(defun fresh-challenge (&optional seed)
  (if seed (fixture-challenge seed)
      (progn
        (unless *entropy-path* (error "entropy_file_required: --entropy-file PATH (96 fresh random bytes)"))
        (let ((entropy (read-file-bytes *entropy-path* 96)))
          (unless (= (length entropy) 96) (error "entropy_size_required: 96"))
          (initialize-challenge entropy #'unix-time)))))
(defun replay-transcript (path)
  (multiple-value-bind (out frames) (verify-transcript-bytes (read-file-bytes path 8388608))
    (format t "[FIXTURE-MODE] REPLAY frames=~D response-digest=~A~%" frames (hex-bytes (blake2s out)))))
(defun binary-input ()
  #+sbcl (sb-sys:make-fd-stream 0 :input t :element-type '(unsigned-byte 8) :auto-close nil)
  #-sbcl *standard-input*)
(defun binary-output ()
  #+sbcl (sb-sys:make-fd-stream 1 :output t :element-type '(unsigned-byte 8) :auto-close nil)
  #-sbcl *standard-output*)
(defvar *command-arguments* nil)
(defun command-arguments () #+sbcl (cdr sb-ext:*posix-argv*) #-sbcl *command-arguments*)
(defun command-exit (code)
  #+sbcl (sb-ext:exit :code code)
  #-sbcl (error "command_failed exit=~D" code))
(defun run-tests ()
  (setf *checks* 0)
  (dolist (name '("messages" "programs" "sequences" "digests" "isolation"))
    (load (merge-pathnames (format nil "tests/~A.lisp" name) *root*)))
  (format t "SELFTEST checks=~D failures=0~%" *checks*))
(defun command-option (args name default)
  (let ((tail (member name args :test #'equal)))
    (if tail (if (second tail) (read-number (second tail) 0 #xffffffffffffffff)
                 (error "missing_option_value: ~A" name)) default)))
(defun demo-challenge (state fixturep)
  (when fixturep (format t "[FIXTURE-MODE] public-seed; fixed Unix time 1700000000~%"))
  (format t "TARGET salt=~A digest=~A~%" (hex-bytes (challenge-salt state)) (hex-bytes (challenge-digest state)))
  (format t "TENANT-A token=~A~%TENANT-B token=~A~%"
          (hex-bytes (first (challenge-tokens state))) (hex-bytes (second (challenge-tokens state))))
  (dolist (spec '((0 2 0 1 0) (0 3 0 1 901) (0 2 0 1 0) (1 2 1 1 0) (1 3 1 1 999) (0 2 2 1 0)))
    (destructuring-bind (token kind row column value) spec
      (format t "DEMO row=~D kind=~D outcome=~S~%" row kind
              (ledger-operation state (nth token (challenge-tokens state))
                                (make-request :kind kind :relation 7 :row row :column column :value value))))))
(defun dispatch-command (args)
  (let ((command (or (first args) "selftest"))
        (*entropy-path* (second (member "--entropy-file" args :test #'equal))))
    (cond
      ((equal command "selftest") (run-tests))
      ((equal command "demo")
       (let ((seed (command-option args "--fixture-seed" nil)))
         (demo-challenge (fresh-challenge seed) seed)))
      ((equal command "program")
       (unless (second args) (error "program_path_required"))
       (let* ((bytes (read-file-bytes (merge-pathnames (second args) *root*) 16384))
              (text (map 'string #'code-char bytes)) (parsed (source-program text)))
         (unless (okp parsed) (error "program_parse: ~S" (result-detail parsed)))
         (let ((out (run-program (result-value parsed))))
           (format t "PROGRAM kind=~A code=~D values=~S~%" (outcome-kind out) (outcome-code out) (outcome-values out))
           (unless (eq (outcome-kind out) :accepted) (error "program_refused")))))
      ((equal command "replay")
       (unless (second args) (error "transcript_path_required"))
       (replay-transcript (or (probe-file (second args)) (merge-pathnames (second args) *root*))))
      ((equal command "serve-stdio")
       (let* ((seed (command-option args "--fixture-seed" nil)) (state (fresh-challenge seed))
              (in (binary-input)) (out (binary-output)))
         (when seed (format *error-output* "[FIXTURE-MODE] seed=~D~%" seed))
         (format *error-output* "TARGET salt=~A digest=~A~%TENANT-A token=~A~%TENANT-B token=~A~%"
                 (hex-bytes (challenge-salt state)) (hex-bytes (challenge-digest state))
                 (hex-bytes (first (challenge-tokens state))) (hex-bytes (second (challenge-tokens state))))
         (serve-frame-stream in out (make-session :challenge state)
                             :max-operations (command-option args "--max-operations" 1024))))
      (t (error "unknown_command: ~A" command)))
    (format (if (equal command "serve-stdio") *error-output* *standard-output*)
            "BORROWGLASS-COMPLETE command=~A status=OK~%" command)))
(defun print-process-memory ()
  (room nil))
(defun print-ast-memory () (print-process-memory))
(defun print-checker-memory () (print-process-memory))
(defun print-primitive-memory () (print-process-memory))
(defun print-region-memory () (print-process-memory))
(defvar *run-main* t)
(handler-case
    (progn
      (dolist (name '("values" "state" "policy" "bytes" "digest" "program" "engine" "message" "table" "session"))
        (load (merge-pathnames (format nil "src/~A.lisp" name) *root*)))
      (when *run-main* (dispatch-command (command-arguments))))
  (serious-condition (condition)
    (format *error-output* "BORROWGLASS-ERROR status=ERROR detail=~S~%" (princ-to-string condition))
    (command-exit 1)))

(unless (find-package :borrowglass)
  (load (merge-pathnames "../src/package.lisp" *load-truename*)))
(unless (boundp 'borrowglass::*root*)
  (defparameter borrowglass::*run-main* nil)
  (load (merge-pathnames "../run.lisp" *load-truename*)))
(in-package :borrowglass)
(let* ((state (fresh-challenge 1101))
       (frames (request-frames (first (challenge-tokens state))
                              (make-request :kind 2 :relation 7 :row 0 :column 1))))
  (let ((out (exercise-stream (apply #'cat-bytes frames) state)))
    (insist (= (length out) 128) "stream_single_response")
    (insist (= (get-le out 32 4) 0) "stream_read_accepted")
    (insist (= (get-le out 44 4) 101) "stream_read_projected_value")
    (insist (zero-range-p out 48 128) "stream_response_unused_zero"))
  (dolist (sequence (list (list (second frames)) (list (first frames) (first frames))
                          (reverse frames) (append (subseq frames 0 3) (last frames))))
    (let ((out (exercise-stream (apply #'cat-bytes sequence) (fresh-challenge 1101))))
      (insist (> (length out) 0) "sequence_error_has_response")
      (insist (/= (get-le out 32 4) 0) "sequence_refused")))
  (let ((out (exercise-stream (apply #'cat-bytes frames) state :max-operations 4)))
    (insist (= (length out) 0) "frame_budget_counts_fragments"))
  (let ((out (exercise-stream (subseq (first frames) 0 17) state)))
    (insist (and (= (length out) 128) (= (get-le out 32 4) 3)) "truncated_stream_refused"))
  (let ((s (make-session :challenge state)))
    (session-frame s (first frames))
    (session-frame s (second frames))
    (session-frame s (first frames))
    (insist (and (null (session-pending-id s)) (zerop (session-next-index s))) "assembly_error_clears_state")))

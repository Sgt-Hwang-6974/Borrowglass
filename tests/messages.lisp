(unless (find-package :borrowglass)
  (load (merge-pathnames "../src/package.lisp" *load-truename*)))
(unless (boundp 'borrowglass::*root*)
  (defparameter borrowglass::*run-main* nil)
  (load (merge-pathnames "../run.lisp" *load-truename*)))
(in-package :borrowglass)
(let* ((state (fresh-challenge 1101)) (raw (first (challenge-tokens state)))
       (frames (request-frames raw (make-request :kind 2 :relation 7 :row 0 :column 1))))
  (insist (= (length raw) 384) "token_exact_size")
  (insist (okp (open-token-bytes raw)) "token_decode")
  (insist (equalp raw (result-value (seal-token-bytes (result-value (open-token-bytes raw))))) "token_roundtrip")
  (dolist (f frames) (insist (okp (parse-frame f)) "frame_positive"))
  (dolist (offset '(0 4 6 16 24 28))
    (let ((f (copy-seq (first frames))))
      (setf (aref f offset) (logxor 255 (aref f offset)))
      (insist (not (okp (parse-frame f))) "frame_header_refusal")))
  (dolist (spec '((64 0 :empty-predicate) (65 65 :caveat-cap) (65 1 :caveat-alignment)
                  (0 2 :version) (36 16 :flags) (66 99 :predicate-op) (67 99 :comparison-op)
                  (68 1 :predicate-pad) (351 1 :variable-padding)))
    (destructuring-bind (offset value reason) spec
      (let ((b (copy-seq raw)))
        (setf (aref b offset) value)
        (let ((r (open-token-bytes b)))
          (insist (and (not (okp r)) (eq (car (result-detail r)) reason)) "codec_refusal_reason")))))
  (insist (not (okp (open-token-bytes (subseq raw 1)))) "codec_wrong_length")
  (let ((tok (result-value (open-token-bytes raw))))
    (setf (capability-serial tok) 1)
    (insist (eq (car (result-detail (seal-token-bytes tok))) :serial) "deferred_serial")))
(let* ((raw (first (challenge-tokens (fresh-challenge 1101))))
       (token (result-value (open-token-bytes raw))))
  (dolist (case '((255 64 :variable-overflow) (1 0 :truncated) (17 0 :unconsumed)))
    (destructuring-bind (pn cn why) case
      (let ((b (copy-seq raw)))
        (setf (aref b 64) pn (aref b 65) cn)
        (insist (eq (car (result-detail (open-token-bytes b))) why) "codec_directory_family"))))
  (dolist (case '((35 :parse-limit) (17 :predicate-bounds)))
    (destructuring-bind (pn why) case
      (let ((b (copy-seq raw)))
        (fill b 0 :start 66 :end 352)
        (setf (aref b 64) pn)
        (fill b 7 :start 66 :end (+ 65 pn))
        (setf (aref b (+ 65 pn)) 1)
        (insist (eq (car (result-detail (open-token-bytes b))) why) "codec_parser_bound_family"))))
  (setf (capability-caveats token) (make-list 5 :initial-element (make-caveat :mask 15 :expiry 1700000100)))
  (insist (eq (car (result-detail (seal-token-bytes token))) :caveat-cap) "codec_encoder_caveat_cap"))

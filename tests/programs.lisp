(unless (find-package :borrowglass)
  (load (merge-pathnames "../src/package.lisp" *load-truename*)))
(unless (boundp 'borrowglass::*root*)
  (defparameter borrowglass::*run-main* nil)
  (load (merge-pathnames "../run.lisp" *load-truename*)))
(in-package :borrowglass)
(dolist (text '("#.(quit)" "(a" "(a))" "(a) (b)"))
  (insist (not (okp (parse-bg text))) "reader_malformed"))
(insist (not (okp (parse-bg (make-string 16385 :initial-element #\a)))) "reader_byte_bound")
(insist (not (okp (parse-bg (make-string 129 :initial-element #\a)))) "reader_atom_bound")
(insist (not (okp (parse-bg (concatenate 'string (make-string 66 :initial-element #\()
                                        "x" (make-string 66 :initial-element #\)))))) "reader_depth_bound")
(insist (okp (parse-bg "(program (i64 42))")) "reader_positive")
(insist (equal (guarded-division :div -7 3) '(:result-ok ((:i64 -2)))) "negative_div_truncates")
(insist (equal (guarded-division :mod -7 3) '(:result-ok ((:i64 -1)))) "negative_mod_sign")
(insist (equal (guarded-division :div (- (ash 1 63)) -1) '(:result-error :range)) "division_overflow")
(insist (equal (guarded-division :div 7 0) '(:result-error :zero)) "division_zero")
(insist (equal (checked-arithmetic :add (1- (ash 1 63)) 1) '(:result-error :range)) "checked_overflow")
(insist (not (okp (token-match '("permit") '("permit" "extra")))) "ownership_drop")
(insist (not (okp (token-match '("permit" "permit") '("permit")))) "ownership_dup")
(insist (not (okp (no-shadow '("v") '(("v" :u32)) nil))) "binding_shadow")
(let* ((p (fixture-expression-program '(:arith :add (:i64 19) (:i64 23) 22003)))
       (out (run-program p)))
  (insist (and (eq (outcome-kind out) :accepted) (equal (outcome-values out) '((:i64 42)))) "program_through_checker_and_evaluator")
  (setf (program-fuel p) 0)
  (insist (eq (outcome-kind (run-program p)) :runtime) "bounded_fuel"))

(defun test-source-run (body types &optional (params "()") (env "()") (extra ""))
  (let* ((text (format nil "(program (module bg.primitive.memory ((r 6 row 1024 0)) (~A (fn entry ((r row unique)) ~A (result ~A true 22003) 1 () 8 ~A)) 4 15 15 (true) none true) entry ~A (1 101 102 103) 1024)"
                extra params types body env))
         (parsed (source-program text)))
    (insist (okp parsed) "full_source_decodes")
    (run-program (result-value parsed))))
(let ((out (test-source-run
  "(let x u32 (word32 xor (u32 10) (u32 6)) (if (boolean and (bool true) (cmp eq (var x u32) (u32 12))) (return ok ((word64 add (u64 18446744073709551615) (u64 1))) ()) (return ok ((u64 9)) ())))" "(u64)")))
  (insist (and (eq (outcome-kind out) :accepted) (equal (outcome-values out) '((:u64 0)))) "full_source_let_if_word_bool_cmp"))
(let ((out (test-source-run
  "(match (call earlier ((i64 42))) ((answer i64)) (return ok ((var answer i64)) ()) (err ()) (return refuse () () 22003))"
  "(i64)" "()" "()"
  "(fn earlier () ((x i64)) (result (i64) false 22003) 0 () 1 (return ok ((var x i64)) ()))")))
  (insist (equal (outcome-values out) '((:i64 42))) "full_source_pure_call"))
(dolist (exit '(nil t))
  (let* ((body (format nil "(loop 3 64 ((n u64 (u64 0))) (return ~A ((word64 add (var n u64) (u64 1))) ()) (return ok ((var n u64)) ()))" (if exit "exit" "continue")))
         (out (test-source-run body "(u64)")))
    (insist (and (eq (outcome-kind out) :accepted)
                 (equal (outcome-values out) (list (list :u64 (if exit 1 3))))) "full_source_bounded_loop")))
(let ((out (test-source-run "(return filtered () ())" "(u32)")))
  (insist (eq (outcome-kind out) :filtered) "full_source_filtered"))
(let ((out (test-source-run "(return refuse () () 22012)" "(u32)")))
  (insist (and (eq (outcome-kind out) :runtime) (eq (outcome-reason out) :zero)
               (= (outcome-code out) 22012)) "full_source_explicit_refusal_code"))
(let ((out (test-source-run
  "(match (shift rotate (u32 305419896) (u32 8) 32 22003) ((x u32)) (return ok ((var x u32)) ()) (err ()) (return refuse () () 22003))" "(u32)")))
  (insist (equal (outcome-values out) '((:u32 2014458966))) "full_source_shift"))
(let ((out (test-source-run
  "(loop 1 0 () (return continue () ()) (return ok ((u32 1)) ()))" "(u32)")))
  (insist (and (eq (outcome-kind out) :accepted) (equal (outcome-values out) '((:u32 1))))
          "empty_loop_context_is_present"))
(let ((out (test-source-run
  "(loop 1 64 ((x (result (i64) false 22003) (add (i64 1) (i64 2)))) (return continue () ()) (return ok () ()))" "()")))
  (insist (and (eq (outcome-kind out) :static) (eq (outcome-reason out) :syntax))
          "loop_result_initializer_requires_match"))
(let ((out (test-source-run
  "(return ok ((var permit (token row-borrow r)) (var permit (token row-borrow r))) ())"
  "((token row-borrow r))" "((permit (token row-borrow r)))" "((permit (row-token 1 6 0)))")))
  (insist (equal (outcome-detail out) "duplicated_linear_token:permit") "duplicate_expression_token_precedes_drop"))
(insist (not (okp (source-program "(program (module a () () 4 15 15 (true) none true) entry () () 1024) trailing")))
        "full_source_trailing_input")
(insist (okp (source-program "(program (module user-never-intern-this-id () () 4 15 15 (true) none true) entry () () 1024)"))
        "identifier_fixture_parses")
(insist (null (find-symbol "user-never-intern-this-id" :borrowglass)) "reader_does_not_intern_identifiers")

(let* ((select (run-program (example-select-program)))
       (initialize (run-program (example-initialize-call))))
  (insist (and (eq (outcome-kind select) :accepted)
               (equal (first (outcome-values select)) '(:i64 3))
               (= (arena-cap-epoch (second (second (outcome-values select)))) 1))
          "fixture_select_returns_value_and_new_epoch")
  (insist (and (eq (outcome-kind initialize) :accepted)
               (equal (first (outcome-values initialize)) '(:i64 42))
               (= (arena-cap-used (second (second (outcome-values initialize)))) 32))
          "fixture_initialize_preserves_predicate_allocation"))
(let ((outcome (run-program (example-authentication "bg.primitive.crypto"
                 :static :session :session 32 64 32 :bool))))
  (insist (and (eq (outcome-kind outcome) :runtime)
               (eq (outcome-reason outcome) :privilege)
               (= (outcome-code outcome) 42501)) "coordinate_authentication_never_grants_access"))
(let* ((token (fitting-token-fixture)) (encoded (seal-token-bytes token))
       (decoded (open-token-bytes (result-value encoded))))
  (insist (and (okp decoded) (= (length (predicate-bytes (capability-predicate token))) 136)
               (= (length (capability-caveats (result-value decoded))) 4)
               (equalp (result-value encoded) (result-value (seal-token-bytes (result-value decoded)))))
          "maximal_codec_fixture_exact_roundtrip")
  (insist (equal (result-detail (seal-token-bytes (overflowing-token-fixture)))
                 '(:variable-overflow 136 160)) "maximal_codec_variable_overflow_precedence"))

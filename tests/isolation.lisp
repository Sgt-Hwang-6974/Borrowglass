(unless (find-package :borrowglass)
  (load (merge-pathnames "../src/package.lisp" *load-truename*)))
(unless (boundp 'borrowglass::*root*)
  (defparameter borrowglass::*run-main* nil)
  (load (merge-pathnames "../run.lisp" *load-truename*)))
(in-package :borrowglass)
(let* ((state (fresh-challenge 1101)) (a (first (challenge-tokens state)))
       (b (second (challenge-tokens state))) (c (third (challenge-tokens state)))
       (original-b (copy-list (aref (challenge-rows state) 1)))
       (original-c (copy-list (aref (challenge-rows state) 2))))
  (labels ((operation (token kind row column &optional (value 0))
             (let ((out (exercise-stream
                          (apply #'cat-bytes (request-frames token (make-request :kind kind :relation 7
                                                                  :row row :column column :value value))) state)))
               (insist (= (length out) 128) "isolation_response_size")
               (list (get-le out 32 4) (get-le out 44 4)))))
    (insist (equal (operation a 3 0 1 901) '(0 901)) "a_write_returned_slice_value")
    (insist (= (second (aref (challenge-rows state) 0)) 901) "a_write_stored")
    (insist (equal (operation a 2 0 1) '(0 901)) "a_read_after_write")
    (insist (equal (operation b 2 1 1) '(0 201)) "b_read_own_row")
    (insist (/= (first (operation b 3 1 1 999)) 0) "b_readonly_write_refused")
    (insist (/= (first (operation a 3 1 1 999)) 0) "a_token_b_row_write_refused")
    (let ((forged (copy-seq b)))
      (put-le forged 36 4 15)
      (insist (/= (first (operation forged 3 1 1 999)) 0) "forged_privileges_refused"))
    (dolist (token (list a b))
      (dolist (kind '(2 3))
        (let ((r (operation token kind 2 1 999)))
          (insist (and (/= (first r) 0) (= (second r) 0)) "c_no_projected_bytes"))))
    (insist (equal original-b (aref (challenge-rows state) 1)) "b_unchanged")
    (insist (equal original-c (aref (challenge-rows state) 2)) "c_unchanged")
    (let ((recovered (cons 3 (loop for col from 1 to 3 collect (second (operation c 2 2 col))))))
      (insist (equalp (target-digest (challenge-salt state) recovered) (challenge-digest state)) "operator_recovers_committed_c"))
    (let ((narrow (attenuate-token (challenge-key state) a (make-caveat :mask 3 :expiry 1700000010)
                                   3 '(:literal 0 :eq 1))))
      (insist (okp narrow) "attenuation_issued")
      (insist (/= (first (operation (result-value narrow) 3 1 1 999)) 0) "attenuated_a_cannot_write_b")
      (setf (challenge-clock state) (constantly 1700000010))
      (insist (/= (first (operation (result-value narrow) 2 0 1)) 0) "caveat_exact_expiry"))
    (setf (challenge-clock state) (constantly 1699999999))
    (insist (/= (first (operation a 2 0 1)) 0) "not_before_boundary")
    (setf (challenge-clock state) (constantly 1700000000))
    (setf (challenge-floors state) (first (result-value (advance-floor (challenge-floors state) 7))))
    (insist (/= (first (operation a 2 0 1)) 0) "floor_immediate_revocation")))
(let* ((state (fresh-challenge 1101)) (a (first (challenge-tokens state))))
  (setf (challenge-tx state) (result-value (bump-epoch (challenge-tx state))))
  (let ((r (ledger-operation state a (make-request :kind 2 :relation 7 :row 0 :column 1))))
    (insist (and (eq (first r) :refused) (= (third r) 53200)) "transaction_epoch_revocation")))
